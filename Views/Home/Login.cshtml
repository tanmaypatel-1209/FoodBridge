@{
    ViewData["Title"] = "Sign in to FoodBridge";
}

<section class="signup-page login-page">
    <div class="signup-orb signup-orb-one"></div>
    <div class="signup-orb signup-orb-two"></div>

    <div class="signup-shell">
        <aside class="signup-intro">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="FoodBridge home">
                <span class="brand-mark" aria-hidden="true">&hearts;</span>
                <span>FoodBridge</span>
            </a>
            <div class="intro-copy">
                <p class="eyebrow">Welcome back</p>
                <h1>Every shared meal starts with a connection.</h1>
                <p>Sign in to continue making a difference in your local food community.</p>
            </div>
            <div class="impact-points">
                <div><span class="impact-icon">&#10022;</span><span>Share what you have</span></div>
                <div><span class="impact-icon">&#10022;</span><span>Find food when it matters</span></div>
                <div><span class="impact-icon">&#10022;</span><span>Strengthen your community</span></div>
            </div>
            <p class="intro-footer">Together, we can make good food go further.</p>
        </aside>

        <main class="signup-card login-card">
            <div class="card-heading">
                <span class="welcome-badge">Good to see you</span>
                <h2>Welcome back</h2>
                <p>Enter your details to access FoodBridge.</p>
            </div>

            <form id="loginForm" novalidate>
                <div class="form-group">
                    <label for="email">Email address</label>
                    <div class="input-wrap">
                        <span class="field-icon" aria-hidden="true">&#9993;</span>
                        <input id="email" name="EmailID" type="email" placeholder="you@example.com" autocomplete="email" required />
                    </div>
                </div>

                <div class="form-group">
                    <div class="label-row">
                        <label for="password">Password</label>
                        <a href="#" class="forgot-link">Forgot password?</a>
                    </div>
                    <div class="input-wrap">
                        <span class="field-icon" aria-hidden="true">&#9674;</span>
                        <input id="password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" required />
                        <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false">Show</button>
                    </div>
                </div>

                <label class="remember-check">
                    <input id="rememberMe" type="checkbox" />
                    <span>Keep me signed in</span>
                </label>

                <p id="formMessage" class="form-message" role="status" aria-live="polite"></p>
                <button id="loginButton" class="signup-button" type="submit">Sign in <span aria-hidden="true">&rarr;</span></button>
            </form>

            <p class="signin-note">New to FoodBridge? <a asp-controller="Home" asp-action="Index">Create an account</a></p>
        </main>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('loginForm');
            const button = document.getElementById('loginButton');
            const message = document.getElementById('formMessage');
            const password = document.getElementById('password');
            const toggle = document.querySelector('.password-toggle');
            const rememberMe = document.getElementById('rememberMe');
            const tokenKey = 'foodBridge.jwt';

            toggle.addEventListener('click', () => {
                const hidden = password.type === 'password';
                password.type = hidden ? 'text' : 'password';
                toggle.textContent = hidden ? 'Hide' : 'Show';
                toggle.setAttribute('aria-label', hidden ? 'Hide password' : 'Show password');
                toggle.setAttribute('aria-pressed', String(hidden));
            });

            form.addEventListener('submit', async (event) => {
                event.preventDefault();
                message.textContent = '';
                message.className = 'form-message';

                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    message.textContent = 'Please enter your email address and password.';
                    message.classList.add('is-error');
                    return;
                }

                button.disabled = true;
                button.innerHTML = 'Signing you in <span class="button-loader" aria-hidden="true"></span>';

                try {
                    const response = await fetch('/login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            EmailID: document.getElementById('email').value.trim(),
                            password: password.value
                        })
                    });
                    const token = (await response.text()).trim();
                    if (!response.ok || !token) {
                        throw new Error(token || 'Unable to sign in. Please try again.');
                    }

                    const storage = rememberMe.checked ? localStorage : sessionStorage;
                    const otherStorage = rememberMe.checked ? sessionStorage : localStorage;
                    otherStorage.removeItem(tokenKey);
                    storage.setItem(tokenKey, token);

                    message.textContent = 'Signed in successfully. Welcome back!';
                    message.classList.add('is-success');
                } catch (error) {
                    message.textContent = error.message || 'Something went wrong. Please try again.';
                    message.classList.add('is-error');
                } finally {
                    button.disabled = false;
                    button.innerHTML = 'Sign in <span aria-hidden="true">&rarr;</span>';
                }
            });
        })();
    </script>
}
