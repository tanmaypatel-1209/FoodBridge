@{
    ViewData["Title"] = "Receiver Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container" id="receiverHomePage">

    <!-- Hero -->
    <div class="donor-hero receiver-hero" id="receiverHeroSection">
        <div class="donor-hero-text">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="tag-pill receiver-pill">Receiver Dashboard</span>
                <a href="/Home/Profile" class="btn-secondary-custom" style="padding:3px 10px; font-size:11px; text-decoration:none;">
                    &#9998; Edit Profile
                </a>
            </div>
            <h1 id="receiverGreeting">Welcome back, Receiver.</h1>
            <p>
                Track food requests by category, review fulfillment status, and submit requirements.
            </p>
        </div>
        <div class="donor-metrics">
            <div class="metric-card metric-card-interactive" id="rcvMCardPending" title="View Pending Requests">
                <span class="metric-value highlight" id="rcvMetricPending">—</span>
                <span class="metric-label">Pending</span>
            </div>
            <div class="metric-card metric-card-interactive" id="rcvMCardAllocated" title="View Allocated Requests">
                <span class="metric-value" style="color:#2563eb;" id="rcvMetricAllocated">—</span>
                <span class="metric-label">Allocated</span>
            </div>
            <div class="metric-card metric-card-interactive" id="rcvMCardNotMatched" title="View Unmatched Requests">
                <span class="metric-value" style="color:#dc2626;" id="rcvMetricNotMatched">—</span>
                <span class="metric-label">Not Matched</span>
            </div>
            <div class="metric-card metric-card-interactive" id="rcvMCardDone" title="View Completed Requests">
                <span class="metric-value" style="color:#16a34a;" id="rcvMetricDone">—</span>
                <span class="metric-label">Completed</span>
            </div>
        </div>
    </div>

    <!-- Tab Navigation with 4 Categories + Request Food -->
    <div class="donor-nav-tabs" role="tablist" aria-label="Receiver food categories">
        <button class="tab-btn active" id="tabRcvPending" data-category="pending" role="tab" aria-selected="true" aria-controls="rcvFeedPanel">
            <span class="tab-icon" aria-hidden="true">&#9203;</span> Pending
            <span class="tab-count-badge" id="rcvBadgePending">0</span>
        </button>
        <button class="tab-btn" id="tabRcvAllocated" data-category="Allocated" role="tab" aria-selected="false" aria-controls="rcvFeedPanel">
            <span class="tab-icon" aria-hidden="true">&#129309;</span> Allocated
            <span class="tab-count-badge" id="rcvBadgeAllocated">0</span>
        </button>
        <button class="tab-btn" id="tabRcvNotMatched" data-category="NotMatched" role="tab" aria-selected="false" aria-controls="rcvFeedPanel">
            <span class="tab-icon" aria-hidden="true">&#9888;</span> Not Matched
            <span class="tab-count-badge" id="rcvBadgeNotMatched">0</span>
        </button>
        <button class="tab-btn" id="tabRcvDone" data-category="done" role="tab" aria-selected="false" aria-controls="rcvFeedPanel">
            <span class="tab-icon" aria-hidden="true">&#10003;</span> Completed
            <span class="tab-count-badge" id="rcvBadgeDone">0</span>
        </button>
        <button class="tab-btn" id="tabRcvAdd" role="tab" aria-selected="false" aria-controls="rcvAddPanel" style="margin-left:auto;">
            <span class="tab-icon" aria-hidden="true">&#43;</span> Request Food
        </button>
    </div>

    <!-- Workspace: Feed Panel -->
    <div id="rcvFeedPanel" role="tabpanel" aria-labelledby="tabRcvPending">
        <div class="donor-feed-section">
            <div class="feed-header">
                <div>
                    <h2 id="rcvCategoryHeading" style="font-size:20px;margin:0 0 4px 0;">Pending Food Requests</h2>
                    <p id="rcvCategorySubtitle">
                        Showing requirements currently waiting for matching donors.
                    </p>
                </div>
                <button id="rcvRefreshBtn" class="btn-secondary-custom" type="button" aria-label="Refresh food requests">
                    &#8635; Refresh
                </button>
            </div>

            <!-- Loading -->
            <div id="rcvLoading" style="display:none;text-align:center;padding:36px 0;color:var(--text-muted);">
                <span class="spinner-dot"
                      style="display:inline-block;width:22px;height:22px;border-color:rgba(0,0,0,.1);border-top-color:var(--orange-primary);"
                      aria-hidden="true"></span>
                <span style="margin-left:10px;">Loading requests…</span>
            </div>

            <!-- Error -->
            <div id="rcvError" class="form-message is-error" role="alert" aria-live="assertive"
                 style="display:none;padding:12px 0;"></div>

            <!-- Grid -->
            <div id="rcvFoodGrid" class="food-grid rcv-food-grid" aria-label="Food request listings">
                <!-- Cards rendered by JS -->
            </div>
        </div>
    </div>

    <!-- Workspace: Add Needed Food Panel -->
    <div id="rcvAddPanel" role="tabpanel" aria-labelledby="tabRcvAdd" style="display:none;">
        <div class="donor-portal-card" style="max-width:640px;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h3 class="card-title mb-0">Request Needed Food</h3>
                <span class="portion-pill">POST /NGOs</span>
            </div>
            <p class="card-subtitle">
                Submit a new food requirement for your organisation. Donors in your region will be able to match and fulfill it.
            </p>

            <form id="addNeededFoodForm" novalidate>

                <!-- Receiver Email (auto-filled, readonly) -->
                <div class="form-group mb-3">
                    <label for="nfEmailID">Receiver Email (from your account)</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#9993;</span>
                        <input id="nfEmailID" name="emailID" type="email"
                               placeholder="your-email@example.com"
                               readonly style="background:var(--bg-surface);cursor:not-allowed;" />
                    </div>
                </div>

                <!-- Quantity -->
                <div class="form-group mb-3">
                    <label for="nfQuantity">Quantity Needed (Estimated Servings) <span aria-hidden="true" style="color:var(--orange-primary)">*</span></label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#9830;</span>
                        <input id="nfQuantity" name="quntity" type="number"
                               min="1" placeholder="e.g. 50" required />
                    </div>
                </div>

                <!-- Required Date / Time -->
                <div class="form-group mb-3">
                    <label for="nfRequestDate">Required By (Date &amp; Time)</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#128197;</span>
                        <input id="nfRequestDate" name="requestDateTime" type="datetime-local" />
                    </div>
                </div>

                <!-- Location Row: City & State -->
                <div class="form-group-row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                    <div class="form-group mb-3">
                        <label for="nfCity">City</label>
                        <div class="input-container">
                            <span class="input-icon" aria-hidden="true">&#128205;</span>
                            <input id="nfCity" name="city" type="text" placeholder="e.g. Nadiad" />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label for="nfState">State</label>
                        <div class="input-container">
                            <span class="input-icon" aria-hidden="true">&#127757;</span>
                            <input id="nfState" name="state" type="text" placeholder="e.g. Gujarat" />
                        </div>
                    </div>
                </div>

                <!-- Specific Address / Delivery point -->
                <div class="form-group mb-3">
                    <label for="nfPerfectLocation">Specific Delivery / Drop-off Point</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#9872;</span>
                        <input id="nfPerfectLocation" name="perfectLocation" type="text"
                               placeholder="e.g. Community Center, Station Road, Gate 2" />
                    </div>
                </div>

                <!-- General Location / Description -->
                <div class="form-group mb-3">
                    <label for="nfLocation">Additional Notes / Landmark</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#128221;</span>
                        <input id="nfLocation" name="location" type="text"
                               placeholder="e.g. Urgent requirement for night shelter" />
                    </div>
                </div>

                <!-- Message -->
                <div id="addNeededFoodMessage" class="form-message mb-3" role="alert" aria-live="polite"></div>

                <!-- Submit Button -->
                <button id="addNeededFoodSubmitBtn" class="auth-submit-btn" type="submit">
                    <span>Submit Food Request</span>
                    <span aria-hidden="true">&rarr;</span>
                </button>

            </form>
        </div>
    </div>

</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     EDIT REQUEST MODAL
     ══════════════════════════════════════════════════════════════════════════ -->
<div id="editRequestModal" style="display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,0.55);overflow-y:auto;" role="dialog" aria-modal="true" aria-labelledby="editRequestModalTitle">
    <div style="max-width:540px;margin:40px auto;background:var(--bg-card,#1e293b);border-radius:16px;padding:32px;box-shadow:0 8px 48px rgba(0,0,0,0.4);position:relative;">
        <button id="closeEditRequestModalBtn" type="button" aria-label="Close edit form"
            style="position:absolute;top:16px;right:16px;background:none;border:none;color:var(--text-muted,#94a3b8);font-size:22px;cursor:pointer;line-height:1;">&#10005;</button>

        <h3 id="editRequestModalTitle" style="margin:0 0 6px 0;font-size:20px;font-weight:700;">Edit Food Request</h3>
        <p style="color:var(--text-muted,#94a3b8);font-size:13px;margin:0 0 22px 0;">Update the details below. Quantity cannot be changed if the request is already allocated.</p>

        <form id="editRequestForm" novalidate>
            <input type="hidden" id="editRequestId" />

            <div class="form-group mb-3">
                <label for="editReqQty">Quantity Needed (Servings)</label>
                <div class="input-container">
                    <span class="input-icon" aria-hidden="true">&#9830;</span>
                    <input id="editReqQty" type="number" min="1" placeholder="e.g. 100" />
                </div>
                <small id="editReqQtyNote" style="color:var(--text-muted,#94a3b8);font-size:11px;"></small>
            </div>

            <div class="form-group mb-3">
                <label for="editReqDate">Required By (Date &amp; Time)</label>
                <div class="input-container">
                    <span class="input-icon" aria-hidden="true">&#128197;</span>
                    <input id="editReqDate" type="datetime-local" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                <div class="form-group mb-3">
                    <label for="editReqCity">City</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#128205;</span>
                        <input id="editReqCity" type="text" placeholder="e.g. Nadiad" />
                    </div>
                </div>
                <div class="form-group mb-3">
                    <label for="editReqState">State</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#127757;</span>
                        <input id="editReqState" type="text" placeholder="e.g. Gujarat" />
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label for="editReqLocation">Delivery / Drop-off Point</label>
                <div class="input-container">
                    <span class="input-icon" aria-hidden="true">&#9872;</span>
                    <input id="editReqLocation" type="text" placeholder="e.g. Community Center, Station Road" />
                </div>
            </div>

            <div id="editRequestMessage" class="form-message mb-3" role="alert" aria-live="polite"></div>

            <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:8px;">
                <button id="cancelEditRequestBtn" type="button" class="btn-secondary-custom">Cancel</button>
                <button id="saveEditRequestBtn" type="submit" class="auth-submit-btn" style="padding:10px 28px;">
                    <span>Save Changes</span> <span aria-hidden="true">&rarr;</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     DELETE CONFIRMATION MODAL
     ══════════════════════════════════════════════════════════════════════════ -->
<div id="deleteRequestModal" style="display:none;position:fixed;inset:0;z-index:10001;background:rgba(0,0,0,0.6);align-items:center;justify-content:center;" role="dialog" aria-modal="true" aria-labelledby="deleteRequestModalTitle">
    <div style="max-width:440px;margin:auto;background:var(--bg-card,#1e293b);border-radius:16px;padding:32px;box-shadow:0 8px 48px rgba(0,0,0,0.4);position:relative;top:50%;transform:translateY(-50%);">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
            <span style="font-size:28px;">&#9888;</span>
            <h3 id="deleteRequestModalTitle" style="margin:0;font-size:18px;font-weight:700;">Delete Food Request?</h3>
        </div>
        <p id="deleteRequestModalDesc" style="color:var(--text-muted,#94a3b8);font-size:14px;margin:0 0 24px 0;">
            Are you sure you want to delete this food request? This action cannot be undone.
        </p>
        <input type="hidden" id="deleteRequestId" />
        <div id="deleteRequestModalMsg" class="form-message mb-3" role="alert" aria-live="polite"></div>
        <div style="display:flex;gap:12px;justify-content:flex-end;">
            <button id="cancelDeleteRequestBtn" type="button" class="btn-secondary-custom">Cancel</button>
            <button id="confirmDeleteRequestBtn" type="button"
                style="background:linear-gradient(135deg,#dc2626,#b91c1c);color:#fff;border:none;padding:10px 24px;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;">
                &#128465; Delete
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    // ── Auth Guard ────────────────────────────────────────────────────────────
    var token = window.FoodBridge ? window.FoodBridge.getToken() : '';
    if (!token) { window.location.replace('/Home/Login'); return; }
    if (window.FoodBridge && !window.FoodBridge.isReceiver()) {
        window.location.replace('/Home/Login'); return;
    }

    // ── Personalise Greeting ──────────────────────────────────────────────────
    var email = window.FoodBridge ? window.FoodBridge.getUserEmail() : '';
    var greetingEl = document.getElementById('receiverGreeting');
    if (greetingEl && email) {
        var localPart = email.split('@@')[0];
        greetingEl.textContent = 'Welcome back, ' + localPart.charAt(0).toUpperCase() + localPart.slice(1) + '.';
    }

    // Auto-fill email in form
    var emailInput = document.getElementById('nfEmailID');
    if (emailInput && email) emailInput.value = email;

    // ── Category Configuration ───────────────────────────────────────────────
    var CATEGORIES = {
        'pending': {
            title: 'Pending Food Requests',
            subtitle: 'Requirements waiting to be matched with surplus donations.',
            url: '/NGOs/display/pending',
            emptyText: 'No pending food requests.',
            emptyDesc: 'New food requirements you submit will appear here until matched.'
        },
        'Allocated': {
            title: 'Allocated Food Requests',
            subtitle: 'Requirements matched and reserved with donor food listings.',
            url: '/NGOs/display/Allocated',
            emptyText: 'No allocated food requests.',
            emptyDesc: 'When donor listings match your food needs, they will appear here.'
        },
        'NotMatched': {
            title: 'Unmatched Food Requests',
            subtitle: 'Requirements that could not be matched automatically.',
            url: '/NGOs/display/NotMatched',
            emptyText: 'No unmatched food requests.',
            emptyDesc: 'Requests requiring manual coordination or additional donors.'
        },
        'done': {
            title: 'Completed Food Requests',
            subtitle: 'Requirements that have been fulfilled and received.',
            url: '/NGOs/display/done',
            emptyText: 'No completed food requests yet.',
            emptyDesc: 'Completed distribution cycles will be recorded here.'
        }
    };

    var currentCategory = 'pending';

    // ── UI Elements ──────────────────────────────────────────────────────────
    var categoryTabs = {
        'pending': document.getElementById('tabRcvPending'),
        'Allocated': document.getElementById('tabRcvAllocated'),
        'NotMatched': document.getElementById('tabRcvNotMatched'),
        'done': document.getElementById('tabRcvDone')
    };

    var tabRcvAdd            = document.getElementById('tabRcvAdd');
    var rcvFeedPanel         = document.getElementById('rcvFeedPanel');
    var rcvAddPanel          = document.getElementById('rcvAddPanel');
    var rcvCategoryHeading   = document.getElementById('rcvCategoryHeading');
    var rcvCategorySubtitle  = document.getElementById('rcvCategorySubtitle');
    var rcvLoading           = document.getElementById('rcvLoading');
    var rcvError             = document.getElementById('rcvError');
    var rcvFoodGrid          = document.getElementById('rcvFoodGrid');

    var badges = {
        'pending': document.getElementById('rcvBadgePending'),
        'Allocated': document.getElementById('rcvBadgeAllocated'),
        'NotMatched': document.getElementById('rcvBadgeNotMatched'),
        'done': document.getElementById('rcvBadgeDone')
    };

    var metricEls = {
        'pending': document.getElementById('rcvMetricPending'),
        'Allocated': document.getElementById('rcvMetricAllocated'),
        'NotMatched': document.getElementById('rcvMetricNotMatched'),
        'done': document.getElementById('rcvMetricDone')
    };

    // Metric card clicks
    document.getElementById('rcvMCardPending').addEventListener('click', function() { selectCategory('pending'); });
    document.getElementById('rcvMCardAllocated').addEventListener('click', function() { selectCategory('Allocated'); });
    document.getElementById('rcvMCardNotMatched').addEventListener('click', function() { selectCategory('NotMatched'); });
    document.getElementById('rcvMCardDone').addEventListener('click', function() { selectCategory('done'); });

    Object.keys(categoryTabs).forEach(function(cat) {
        if (categoryTabs[cat]) {
            categoryTabs[cat].addEventListener('click', function() { selectCategory(cat); });
        }
    });

    tabRcvAdd.addEventListener('click', function() { showAddPanel(); });

    function showAddPanel() {
        rcvFeedPanel.style.display = 'none';
        rcvAddPanel.style.display  = '';
        Object.keys(categoryTabs).forEach(function(k) {
            categoryTabs[k].classList.remove('active');
            categoryTabs[k].setAttribute('aria-selected', 'false');
        });
        tabRcvAdd.classList.add('active');
        tabRcvAdd.setAttribute('aria-selected', 'true');
    }

    function selectCategory(cat) {
        if (!CATEGORIES[cat]) return;
        currentCategory = cat;
        rcvFeedPanel.style.display = '';
        rcvAddPanel.style.display  = 'none';
        Object.keys(categoryTabs).forEach(function(k) {
            var isActive = (k === cat);
            categoryTabs[k].classList.toggle('active', isActive);
            categoryTabs[k].setAttribute('aria-selected', String(isActive));
        });
        tabRcvAdd.classList.remove('active');
        tabRcvAdd.setAttribute('aria-selected', 'false');
        rcvCategoryHeading.textContent  = CATEGORIES[cat].title;
        rcvCategorySubtitle.textContent = CATEGORIES[cat].subtitle;
        loadCategoryRequests(cat);
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    function statusBadgeHtml(status) {
        var s = (status || 'pending').toLowerCase();
        var color = '#f97316', bg = 'rgba(249, 115, 22, 0.12)', label = 'Pending';
        if (s === 'pending') { color = '#f97316'; bg = 'rgba(249,115,22,0.12)'; label = 'Pending'; }
        else if (s === 'allocated') { color = '#2563eb'; bg = 'rgba(37,99,235,0.12)'; label = 'Allocated'; }
        else if (s === 'notmatched' || s === 'not matched') { color = '#dc2626'; bg = 'rgba(220,38,38,0.12)'; label = 'Not Matched'; }
        else if (s === 'done' || s === 'completed') { color = '#16a34a'; bg = 'rgba(22,163,74,0.12)'; label = 'Completed'; }
        else if (s === 'cancelled') { color = '#6b7280'; bg = 'rgba(107,114,128,0.12)'; label = 'Cancelled'; }
        return '<span class="status-indicator" style="color:' + color + ';background:' + bg + ';padding:4px 10px;border-radius:999px;font-weight:600;font-size:12px;display:inline-flex;align-items:center;gap:6px;">' +
               '<span class="status-dot" style="background:' + color + ';width:6px;height:6px;border-radius:50%;display:inline-block;"></span>' + label + '</span>';
    }

    function formatDate(dt) {
        if (!dt) return '';
        try { return new Date(dt).toLocaleString('en-IN', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }); }
        catch(e) { return dt; }
    }

    function escHtml(str) {
        return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── REQUEST CARD with Edit/Delete buttons ─────────────────────────────────
    function buildRequestCard(food) {
        var loc = [food.perfectLocation, food.city, food.state, food.location].filter(Boolean).join(', ');
        var items = Array.isArray(food.items) ? food.items : [];
        var tags = items.length
            ? items.map(function (t) { return '<span class="food-item-tag">' + escHtml(t) + '</span>'; }).join('')
            : '';

        var s = (food.status || '').toLowerCase();
        var canEdit   = (s === 'pending' || s === 'notmatched');
        var canDelete  = (s === 'pending' || s === 'notmatched');
        var canCancel  = (s === 'allocated');
        var isLocked   = (s === 'done' || s === 'cancelled');

        var actionBtns = '';
        if (canEdit) {
            actionBtns += '<button class="btn-edit-request btn-card-action" data-req-id="' + food.id + '" title="Edit this request" style="background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;border:none;padding:6px 14px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:5px;">&#9998; Edit</button>';
        }
        if (canDelete) {
            actionBtns += '<button class="btn-delete-request btn-card-action" data-req-id="' + food.id + '" data-req-qty="' + (food.quntity||0) + '" title="Delete this request" style="background:linear-gradient(135deg,#dc2626,#b91c1c);color:#fff;border:none;padding:6px 14px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:5px;">&#128465; Delete</button>';
        }
        if (canCancel) {
            actionBtns += '<button class="btn-delete-request btn-card-action" data-req-id="' + food.id + '" data-req-qty="' + (food.quntity||0) + '" title="Cancel this request" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;border:none;padding:6px 14px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:5px;">&#9747; Cancel</button>';
        }
        if (isLocked) {
            actionBtns += '<span style="font-size:11px;color:var(--text-muted,#94a3b8);font-style:italic;">&#128274; View only</span>';
        }

        return '<article class="food-card rcv-card">' +
            '<div class="food-card-top">' +
                '<h4 class="food-title">' + escHtml(food.foodName || 'Food Requirement') + '</h4>' +
                '<span class="portion-pill">&#9830; ' + (food.quntity || 0) + ' portions</span>' +
            '</div>' +
            '<div class="donor-meta-row">' +
                '<span aria-hidden="true">&#9993;</span>' +
                '<span class="meta-donor">' + escHtml(food.emailID || '') + '</span>' +
                (loc ? '&nbsp;&bull;&nbsp;<span>&#128205; ' + escHtml(loc) + '</span>' : '') +
            '</div>' +
            (tags ? '<div class="item-tags-wrap">' + tags + '</div>' : '') +
            '<div class="food-card-footer">' +
                statusBadgeHtml(food.status) +
                '<span style="color:var(--text-muted);font-size:12px;">' +
                    (food.requestDateTime ? 'Required: ' + formatDate(food.requestDateTime) : '') +
                '</span>' +
            '</div>' +
            (actionBtns ? '<div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">' + actionBtns + '</div>' : '') +
        '</article>';
    }

    // ── Simple Graphical Connection Card for Allocated Matches ───────────────
    function buildMatchedConnectionCard(matched) {
        var food = matched.food || {};
        var need = matched.neededFood || {};
        var del  = matched.delivery || null;

        var donorCity = escHtml(food.city || 'Donor');
        var rcvCity   = escHtml(need.city || food.city || 'Recipient');
        var donorLoc  = escHtml([food.perfectLocation, food.city, food.state].filter(Boolean).join(', ') || food.location || '—');
        var rcvLoc    = escHtml([need.perfectLocation, need.city, need.state].filter(Boolean).join(', ') || need.location || '—');

        var delHtml = '';
        if (del) {
            var stepper = buildReceiverStepperHtml(del.status);
            var receiptAction = '';
            if (del.status === 'Accepted' || del.status === 'TransporterAssigned') {
                receiptAction = '<div style="margin:12px 0;padding:10px 14px;background:#f0f9ff;border:1px solid #bae6fd;border-radius:8px;font-size:13px;color:#0369a1;font-weight:600;">&#128666; A transporter has accepted this delivery and will soon collect the food from the donor.</div>';
            } else if (del.status === 'PickupPending' || del.status === 'PickedUp') {
                receiptAction = '<div style="margin:12px 0;padding:10px 14px;background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;font-size:13px;color:#c2410c;font-weight:600;">&#9203; Transporter <strong>' + escHtml(del.transporterName || del.transporterId || '') + '</strong> is collecting/has collected the food from the donor. On the way to you!</div>';
            } else if (del.status === 'InTransit') {
                receiptAction = '<div style="margin:12px 0;padding:10px 14px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;font-size:13px;color:#1e40af;font-weight:600;">&#128666; Transporter <strong>' + escHtml(del.transporterName || del.transporterId || '') + '</strong> is currently in transit to your location.</div>';
            } else if (del.status === 'ReceiverArrived') {
                receiptAction = '<div class="action-callout-banner banner-receipt">' +
                    '<div class="banner-content">' +
                        '<span class="banner-title">&#127970; Transporter Has Arrived With Food!</span>' +
                        '<span class="banner-desc"><strong>' + escHtml(del.transporterName || del.transporterId || 'Transporter') + '</strong> has arrived at your facility. Please verify and confirm receipt below.</span>' +
                    '</div>' +
                    '<button class="btn-delivery-action btn-confirm-received" data-del-id="' + del.deliveryId + '">&#10003; Confirm Food Received</button>' +
                '</div>';
            } else if (del.status === 'Delivered') {
                receiptAction = '<div style="margin:12px 0;padding:10px 14px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;font-size:13px;color:#166534;font-weight:700;">&#10003; Delivery Completed &amp; Verified! Food successfully received by your facility.</div>';
            } else {
                receiptAction = '<div style="margin:12px 0;padding:10px 14px;background:#fafafa;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;color:#64748b;font-weight:500;">&#9203; Waiting for a transporter to accept this delivery job.</div>';
            }
            delHtml = '<div style="margin-top:14px;padding-top:14px;border-top:1px dashed var(--border-subtle,#e2e8f0);">' +
                '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">' +
                    '<span style="font-size:12px;font-weight:700;text-transform:uppercase;color:#475569;">Delivery Status: <strong style="color:var(--text-primary,#1e293b);">' + escHtml(del.status) + '</strong></span>' +
                    '<span style="font-size:12px;color:#64748b;">Transporter: <strong>' + escHtml(del.transporterName || del.transporterId || 'Awaiting Partner') + '</strong></span>' +
                '</div>' + stepper + receiptAction + '</div>';
        }

        // Cancel button for allocated (if not yet picked up)
        var cancelBtn = '';
        var isPickedUpOrBeyond = del &&
            (del.status === 'PickedUp' || del.status === 'InTransit' || del.status === 'ReceiverArrived' || del.status === 'Delivered');
        if (need.id && !isPickedUpOrBeyond) {
            cancelBtn = '<div style="margin-top:12px;">' +
                '<button class="btn-delete-request btn-card-action" data-req-id="' + need.id + '" data-req-qty="' + (need.quntity||0) + '"' +
                ' style="background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;border:none;padding:6px 14px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:5px;">&#9747; Cancel Request</button>' +
                '</div>';
        }

        return '<article class="match-simple-card">' +
            '<div class="match-simple-header">' +
                '<div class="match-simple-title"><strong>Allocated Match</strong><span class="match-route-tag">' + donorCity + ' &rarr; ' + rcvCity + '</span></div>' +
                '<span class="match-badge-simple">Allocated</span>' +
            '</div>' +
            '<div class="match-simple-body">' +
                '<div class="match-col">' +
                    '<div class="match-col-role role-donor">&#127869; DONOR</div>' +
                    '<h4 class="col-food-title">' + escHtml(food.foodName || food.FoodName || 'Donated Food') + '</h4>' +
                    '<div><span class="col-qty-pill qty-donor">&#9830; ' + (food.quntity || 0) + ' Servings</span></div>' +
                    '<div class="col-info-list">' +
                        '<div class="col-info-item"><span class="icon">&#9993;</span> ' + escHtml(food.emailID || '—') + '</div>' +
                        '<div class="col-info-item"><span class="icon">&#128205;</span> ' + donorLoc + '</div>' +
                        (food.donationDateTime ? '<div class="col-info-item"><span class="icon">&#128197;</span> ' + formatDate(food.donationDateTime) + '</div>' : '') +
                    '</div>' +
                '</div>' +
                '<div class="match-connector"><div class="connector-line"></div><div class="connector-icon-circle">&#8646;</div><div class="connector-label">MATCHED</div></div>' +
                '<div class="match-col">' +
                    '<div class="match-col-role role-receiver">&#127970; YOUR FACILITY</div>' +
                    '<h4 class="col-food-title">' + escHtml(need.foodName || 'Your Requirement') + '</h4>' +
                    '<div><span class="col-qty-pill qty-receiver">&#9830; ' + (need.quntity || 0) + ' Servings Needed</span></div>' +
                    '<div class="col-info-list">' +
                        '<div class="col-info-item"><span class="icon">&#9993;</span> ' + escHtml(need.emailID || '—') + '</div>' +
                        '<div class="col-info-item"><span class="icon">&#128205;</span> ' + rcvLoc + '</div>' +
                        (need.requestDateTime ? '<div class="col-info-item"><span class="icon">&#128197;</span> ' + formatDate(need.requestDateTime) + '</div>' : '') +
                    '</div>' +
                '</div>' +
            '</div>' +
            delHtml + cancelBtn +
            '<div class="match-simple-footer">' +
                '<div>Pickup: <strong>' + donorLoc + '</strong> &rarr; Delivery: <strong>' + rcvLoc + '</strong></div>' +
                (food.emailID ? '<a href="mailto:' + escHtml(food.emailID) + '?subject=FoodBridge%20Allocation%20Handover">&#9993; Coordinate with Donor</a>' : '') +
            '</div>' +
        '</article>';
    }

        function buildReceiverStepperHtml(status) {
            var steps = [
                { key: 'Matched', label: 'Matched' },
                { key: 'Accepted', label: 'Transporter' },
                { key: 'PickedUp', label: 'Picked Up' },
                { key: 'InTransit', label: 'In Transit' },
                { key: 'ReceiverArrived', label: 'Arrived' },
                { key: 'Delivered', label: 'Received' }
            ];
            var stepOrder = ['AwaitingTransporter', 'Accepted', 'PickupPending', 'PickedUp', 'InTransit', 'ReceiverArrived', 'Delivered'];
            var currentIdx = stepOrder.indexOf(status);
            if (currentIdx === -1 && (status === 'TransporterAssigned')) currentIdx = 1;
            var html = '<div class="delivery-stepper" style="margin: 14px 0 8px 0;">';
            var pct = Math.max(0, Math.min(100, (currentIdx / (stepOrder.length - 1)) * 100));
            html += `<div class="stepper-progress-line" style="width:${pct}%;"></div>`;
            steps.forEach(function (s, idx) {
                var stepIndex = stepOrder.indexOf(s.key);
                if (s.key === 'Matched') stepIndex = 0;
                var isDone = currentIdx >= stepIndex;
                var isCurr = currentIdx === stepIndex;
                var cls = isDone ? 'is-done' : (isCurr ? 'is-current' : '');
                html += `<div class="stepper-step ${cls}"><div class="stepper-dot">${isDone ? '&#10003;' : (idx + 1)}</div><span class="stepper-step-title">${s.label}</span></div>`;
            });
            html += '</div>';
            return html;
        }

        // ── Feed Loader ──────────────────────────────────────────────────────────
        async function loadCategoryRequests(cat) {
            rcvLoading.style.display = '';
            rcvError.style.display   = 'none';
            rcvFoodGrid.innerHTML    = '';
            var config = CATEGORIES[cat];
            if (!config) return;
            try {
                var [resp, delResp] = await Promise.all([
                    window.FoodBridge.authFetch(config.url),
                    window.FoodBridge.authFetch('/Receiver/deliveries')
                ]);
                if (resp.status === 401 || resp.status === 403 || delResp.status === 401) {
                    window.location.replace('/Home/Login'); return;
                }
                if (!resp.ok) throw new Error('Server returned ' + resp.status);

                var data = await resp.json();
                var deliveries = delResp.ok ? await delResp.json() : [];
                rcvLoading.style.display = 'none';

                var count = Array.isArray(data) ? data.length : 0;
                if (badges[cat]) badges[cat].textContent = count;
                if (metricEls[cat]) metricEls[cat].textContent = count;

                if (!Array.isArray(data) || data.length === 0) {
                    rcvFoodGrid.classList.remove('allocation-feed-layout');
                    rcvFoodGrid.innerHTML =
                        '<div class="empty-state"><span class="empty-icon" aria-hidden="true">&#127860;</span>' +
                        '<h4>' + escHtml(config.emptyText) + '</h4><p>' + escHtml(config.emptyDesc) + '</p></div>';
                    return;
                }

                if (cat === 'Allocated') {
                    rcvFoodGrid.classList.add('allocation-feed-layout');
                    rcvFoodGrid.innerHTML = data.map(function(item) {
                        if (item.food && item.neededFood) {
                            // ── STRICT match by foodId (which maps 1:1 to this specific allocation).
                            // Never fall back to receiverId — a receiver can have multiple concurrent
                            // allocations and the receiverId fallback would pick the wrong delivery.
                            var del = deliveries.find(function (d) {
                                return item.food && d.foodId === item.food.id;
                            }) || null;
                            item.delivery = del;
                            return buildMatchedConnectionCard(item);
                        }
                        return buildRequestCard(item);
                    }).join('');

                    // Bind confirm received buttons
                    rcvFoodGrid.querySelectorAll('.btn-confirm-received').forEach(function(btn) {
                        btn.addEventListener('click', async function() {
                            var delId = btn.getAttribute('data-del-id');
                            if (!delId) return;
                            var notes = prompt('Add optional delivery receipt notes (or press OK to confirm):') || '';
                            btn.disabled = true;
                            btn.innerHTML = 'Confirming receipt… <span class="spinner-dot" aria-hidden="true"></span>';
                            try {
                                var cResp = await window.FoodBridge.authFetch('/Receiver/deliveries/' + delId + '/confirm-received', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ Notes: notes })
                                });
                                var resJson = await cResp.json().catch(function() { return {}; });
                                if (!cResp.ok) {
                                    alert(resJson.message || 'Failed to confirm receipt.');
                                    btn.disabled = false;
                                    btn.innerHTML = '&#10003; Confirm Food Received';
                                    return;
                                }
                                showToast('&#127881; Food delivery receipt confirmed! Thank you.', 'success');
                                loadCategoryRequests(currentCategory);
                                refreshAllCounts();
                            } catch (cErr) {
                                alert('Network error: ' + cErr.message);
                                btn.disabled = false;
                                btn.innerHTML = '&#10003; Confirm Food Received';
                            }
                        });
                    });

                } else {
                    rcvFoodGrid.classList.remove('allocation-feed-layout');
                    rcvFoodGrid.innerHTML = data.map(buildRequestCard).join('');
                }

                // ── Bind Edit buttons ──────────────────────────────────────────
                rcvFoodGrid.querySelectorAll('.btn-edit-request').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        openEditRequestModal(btn.getAttribute('data-req-id'));
                    });
                });

                // ── Bind Delete/Cancel buttons ─────────────────────────────────
                rcvFoodGrid.querySelectorAll('.btn-delete-request').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        openDeleteRequestModal(btn.getAttribute('data-req-id'), btn.getAttribute('data-req-qty'));
                    });
                });

            } catch (err) {
                rcvLoading.style.display = 'none';
                rcvError.style.display   = '';
                rcvError.textContent     = 'Failed to load ' + cat + ' requests: ' + (err.message || 'Unknown error.');
            }
        }

    async function refreshAllCounts() {
        var promises = Object.keys(CATEGORIES).map(async function(cat) {
            try {
                var resp = await window.FoodBridge.authFetch(CATEGORIES[cat].url);
                if (resp.ok) {
                    var data = await resp.json();
                    var count = Array.isArray(data) ? data.length : 0;
                    if (badges[cat]) badges[cat].textContent = count;
                    if (metricEls[cat]) metricEls[cat].textContent = count;
                }
            } catch(e) { }
        });
        return Promise.all(promises);
    }

    // ── Toast ─────────────────────────────────────────────────────────────────
    function showToast(message, type) {
        var toastId = 'rcvToastContainer';
        var container = document.getElementById(toastId);
        if (!container) {
            container = document.createElement('div');
            container.id = toastId;
            container.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:10px;';
            document.body.appendChild(container);
        }
        var toast = document.createElement('div');
        var bgColor = type === 'success' ? '#166534' : type === 'error' ? '#991b1b' : type === 'warning' ? '#92400e' : '#1e40af';
        var icon    = type === 'success' ? '&#10003;' : type === 'error' ? '&#9888;' : type === 'warning' ? '&#9888;' : '&#128666;';
        toast.style.cssText = 'background:' + bgColor + ';color:#fff;padding:12px 18px;border-radius:10px;font-size:14px;font-weight:600;box-shadow:0 4px 24px rgba(0,0,0,0.18);display:flex;align-items:center;gap:10px;min-width:280px;max-width:400px;';
        toast.innerHTML = '<span style="font-size:18px;">' + icon + '</span><span>' + message + '</span>';
        container.appendChild(toast);
        setTimeout(function() {
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.4s';
            setTimeout(function() { if (toast.parentNode) toast.parentNode.removeChild(toast); }, 400);
        }, 5000);
    }

    // ══════════════════════════════════════════════════════════════════════════
    // EDIT REQUEST MODAL LOGIC
    // ══════════════════════════════════════════════════════════════════════════
    var editReqModal   = document.getElementById('editRequestModal');
    var editReqForm    = document.getElementById('editRequestForm');
    var editReqMsg     = document.getElementById('editRequestMessage');
    var saveEditReqBtn = document.getElementById('saveEditRequestBtn');

    function openEditRequestModal(reqId) {
        editReqMsg.textContent = '';
        editReqMsg.className   = 'form-message mb-3';
        window.FoodBridge.authFetch('/NGOs/' + reqId)
            .then(function(r) {
                if (r.status === 403) { showToast('&#9888; This request does not belong to you.', 'error'); return null; }
                if (!r.ok) { showToast('&#9888; Could not load request data.', 'error'); return null; }
                return r.json();
            })
            .then(function(req) {
                if (!req) return;
                document.getElementById('editRequestId').value  = req.id;
                document.getElementById('editReqQty').value     = req.quntity || '';
                document.getElementById('editReqCity').value    = req.city || '';
                document.getElementById('editReqState').value   = req.state || '';
                document.getElementById('editReqLocation').value = req.perfectLocation || '';
                if (req.requestDateTime) {
                    try {
                        var d = new Date(req.requestDateTime);
                        var pad = function(n) { return String(n).padStart(2, '0'); };
                        document.getElementById('editReqDate').value =
                            d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()) +
                            'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
                    } catch(e) { document.getElementById('editReqDate').value = ''; }
                } else {
                    document.getElementById('editReqDate').value = '';
                }
                var s = (req.status || '').toLowerCase();
                var qtyInput = document.getElementById('editReqQty');
                var qtyNote  = document.getElementById('editReqQtyNote');
                if (s === 'allocated') {
                    qtyInput.disabled = true;
                    qtyInput.style.opacity = '0.5';
                    qtyNote.textContent = 'Quantity is locked — this request is already allocated.';
                } else {
                    qtyInput.disabled = false;
                    qtyInput.style.opacity = '';
                    qtyNote.textContent = '';
                }
                editReqModal.style.display = 'block';
                document.getElementById('editReqQty').focus();
            })
            .catch(function() { showToast('&#9888; Network error loading request data.', 'error'); });
    }

    function closeEditRequestModal() {
        editReqModal.style.display = 'none';
        document.getElementById('editReqQty').disabled = false;
        document.getElementById('editReqQty').style.opacity = '';
    }

    document.getElementById('closeEditRequestModalBtn').addEventListener('click', closeEditRequestModal);
    document.getElementById('cancelEditRequestBtn').addEventListener('click', closeEditRequestModal);
    editReqModal.addEventListener('click', function(e) { if (e.target === editReqModal) closeEditRequestModal(); });

    editReqForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        editReqMsg.textContent = '';
        editReqMsg.className   = 'form-message mb-3';

        var reqId   = document.getElementById('editRequestId').value;
        var qtyRaw  = document.getElementById('editReqQty').value;
        var city    = document.getElementById('editReqCity').value.trim();
        var state   = document.getElementById('editReqState').value.trim();
        var perfLoc = document.getElementById('editReqLocation').value.trim();
        var dateVal = document.getElementById('editReqDate').value;
        var qtyDisabled = document.getElementById('editReqQty').disabled;
        var qty = qtyDisabled ? null : (qtyRaw ? parseInt(qtyRaw, 10) : null);

        if (!qtyDisabled && qty !== null && (isNaN(qty) || qty < 1)) {
            editReqMsg.textContent = 'Quantity must be a positive number greater than 0.';
            editReqMsg.className   = 'form-message mb-3 is-error';
            return;
        }

        var payload = {};
        if (qty !== null) payload.quntity = qty;
        if (city) payload.city = city;
        if (state) payload.state = state;
        if (perfLoc) payload.perfectLocation = perfLoc;
        if (dateVal) payload.requestDateTime = window.FoodBridge.toLocalDateTimeString(dateVal);

        saveEditReqBtn.disabled = true;
        saveEditReqBtn.innerHTML = 'Saving… <span class="spinner-dot" aria-hidden="true"></span>';

        try {
            var resp = await window.FoodBridge.authFetch('/NGOs/' + reqId, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            var resJson = await resp.json().catch(function() { return {}; });
            if (resp.status === 403) {
                editReqMsg.textContent = 'Forbidden: You can only edit your own food requests.';
                editReqMsg.className   = 'form-message mb-3 is-error';
                return;
            }
            if (!resp.ok) {
                editReqMsg.textContent = resJson.message || 'Failed to update food request.';
                editReqMsg.className   = 'form-message mb-3 is-error';
                return;
            }
            showToast('&#10003; Food request updated successfully!', 'success');
            closeEditRequestModal();
            loadCategoryRequests(currentCategory);
            refreshAllCounts();
        } catch(err) {
            editReqMsg.textContent = 'Network error: ' + (err.message || 'Please check your connection.');
            editReqMsg.className   = 'form-message mb-3 is-error';
        } finally {
            saveEditReqBtn.disabled = false;
            saveEditReqBtn.innerHTML = '<span>Save Changes</span> <span aria-hidden="true">&rarr;</span>';
        }
    });

    // ══════════════════════════════════════════════════════════════════════════
    // DELETE REQUEST MODAL LOGIC
    // ══════════════════════════════════════════════════════════════════════════
    var deleteReqModal   = document.getElementById('deleteRequestModal');
    var deleteReqMsgEl   = document.getElementById('deleteRequestModalMsg');
    var confirmDelReqBtn = document.getElementById('confirmDeleteRequestBtn');
    var cancelDelReqBtn  = document.getElementById('cancelDeleteRequestBtn');

    function openDeleteRequestModal(reqId, qty) {
        document.getElementById('deleteRequestId').value = reqId;
        document.getElementById('deleteRequestModalDesc').textContent =
            'Are you sure you want to delete/cancel this food request (' + (qty||'?') + ' servings)? This action cannot be undone.';
        deleteReqMsgEl.textContent = '';
        deleteReqMsgEl.className   = 'form-message mb-3';
        deleteReqModal.style.display = 'flex';
    }

    function closeDeleteRequestModal() { deleteReqModal.style.display = 'none'; }

    cancelDelReqBtn.addEventListener('click', closeDeleteRequestModal);
    deleteReqModal.addEventListener('click', function(e) { if (e.target === deleteReqModal) closeDeleteRequestModal(); });

    confirmDelReqBtn.addEventListener('click', async function() {
        var reqId = document.getElementById('deleteRequestId').value;
        if (!reqId) return;
        deleteReqMsgEl.textContent = '';
        deleteReqMsgEl.className   = 'form-message mb-3';
        confirmDelReqBtn.disabled  = true;
        confirmDelReqBtn.innerHTML = 'Deleting… <span class="spinner-dot" aria-hidden="true"></span>';
        try {
            var resp = await window.FoodBridge.authFetch('/NGOs/' + reqId, { method: 'DELETE' });
            var resJson = await resp.json().catch(function() { return {}; });
            if (resp.status === 403) {
                deleteReqMsgEl.textContent = 'Forbidden: You can only delete your own food requests.';
                deleteReqMsgEl.className   = 'form-message mb-3 is-error';
                return;
            }
            if (!resp.ok) {
                deleteReqMsgEl.textContent = resJson.message || 'Failed to delete food request.';
                deleteReqMsgEl.className   = 'form-message mb-3 is-error';
                return;
            }
            showToast('&#128465; Food request deleted/cancelled successfully.', 'success');
            closeDeleteRequestModal();
            loadCategoryRequests(currentCategory);
            refreshAllCounts();
        } catch(err) {
            deleteReqMsgEl.textContent = 'Network error: ' + (err.message || 'Please check your connection.');
            deleteReqMsgEl.className   = 'form-message mb-3 is-error';
        } finally {
            confirmDelReqBtn.disabled  = false;
            confirmDelReqBtn.innerHTML = '&#128465; Delete';
        }
    });

    // ── Auto-Polling ──────────────────────────────────────────────────────────
    var _lastDeliveryStatuses = {};
    var _rcvAutoRefreshTimer = null;

    function startReceiverAutoRefresh() {
        if (_rcvAutoRefreshTimer) return;
        _rcvAutoRefreshTimer = setInterval(async function() {
            try {
                var delResp = await window.FoodBridge.authFetch('/Receiver/deliveries');
                if (!delResp.ok) return;
                var deliveries = await delResp.json();
                var changed = false;
                deliveries.forEach(function(d) {
                    var prevStatus = _lastDeliveryStatuses[d.deliveryId];
                    if (prevStatus !== undefined && prevStatus !== d.status) {
                        changed = true;
                        if (d.status === 'Accepted') showToast('&#128666; A transporter accepted the delivery for your food request!', 'info');
                        else if (d.status === 'InTransit') showToast('&#128666; Your food is in transit! Transporter ' + (d.transporterName || '') + ' is on the way.', 'info');
                        else if (d.status === 'ReceiverArrived') showToast('&#127970; Transporter has arrived at your location! Please confirm food receipt.', 'warning');
                        else if (d.status === 'Delivered') showToast('&#127881; Food delivery completed and verified! Thank you.', 'success');
                        else if (d.status === 'Cancelled') showToast('&#9888; A delivery was cancelled.', 'warning');
                    }
                    _lastDeliveryStatuses[d.deliveryId] = d.status;
                });
                if (changed && currentCategory === 'Allocated') loadCategoryRequests('Allocated');
                else if (changed) refreshAllCounts();
            } catch(e) { }
        }, 10000);
    }

    window.addEventListener('beforeunload', function() {
        if (_rcvAutoRefreshTimer) clearInterval(_rcvAutoRefreshTimer);
    });

    document.getElementById('rcvRefreshBtn').addEventListener('click', function() {
        loadCategoryRequests(currentCategory);
        refreshAllCounts();
    });

    // ── Form Submission — POST /NGOs ──────────────────────────────────────────
    var addForm   = document.getElementById('addNeededFoodForm');
    var submitBtn = document.getElementById('addNeededFoodSubmitBtn');
    var msgEl     = document.getElementById('addNeededFoodMessage');

    function showMsg(text, isError) {
        msgEl.textContent = text;
        msgEl.className   = 'form-message mb-3 ' + (isError ? 'is-error' : 'is-success');
    }

    function setSubmitting(loading) {
        submitBtn.disabled = loading;
        submitBtn.innerHTML = loading
            ? 'Submitting request… <span class="spinner-dot" aria-hidden="true"></span>'
            : '<span>Submit Food Request</span> <span aria-hidden="true">&rarr;</span>';
    }

    if (addForm) {
        addForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            msgEl.textContent = '';
            msgEl.className   = 'form-message mb-3';

            var quntity = parseInt(document.getElementById('nfQuantity').value, 10);
            var reqDate = document.getElementById('nfRequestDate').value;
            var city    = document.getElementById('nfCity').value.trim();
            var state   = document.getElementById('nfState').value.trim();
            var perfLoc = document.getElementById('nfPerfectLocation').value.trim();
            var notes   = document.getElementById('nfLocation').value.trim();

            if (isNaN(quntity) || quntity < 1) {
                showMsg('Please specify a valid quantity of servings needed (minimum 1).', true);
                return;
            }

            var composedLocation = notes || [perfLoc, city, state].filter(Boolean).join(', ') || null;
            var parsedDateTime   = window.FoodBridge.toLocalDateTimeString(reqDate);

            setSubmitting(true);

            try {
                var resp = await window.FoodBridge.authFetch('/NGOs', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        quntity:         quntity,
                        requestDateTime: parsedDateTime,
                        location:        composedLocation,
                        city:            city || null,
                        state:           state || null,
                        perfectLocation: perfLoc || null
                    })
                });

                if (resp.status === 401 || resp.status === 403) {
                    window.location.replace('/Home/Login');
                    return;
                }

                var text = await resp.text();

                if (text === 'Added' || (resp.ok && text.toLowerCase().includes('added'))) {
                    showMsg('Food request submitted successfully! Viewing your pending requests…', false);
                    addForm.reset();
                    if (emailInput && email) emailInput.value = email;
                    setTimeout(function () {
                        selectCategory('pending');
                        refreshAllCounts();
                    }, 1000);
                } else if (text === 'user not found') {
                    showMsg('User account not found on the server. Please sign in again.', true);
                } else if (!resp.ok) {
                    showMsg('Server error (' + resp.status + '). Please try again.', true);
                } else {
                    showMsg(text || 'Unexpected response.', true);
                }

            } catch (err) {
                showMsg('Network error: ' + (err.message || 'Please check your connection.'), true);
            } finally {
                setSubmitting(false);
            }
        });
    }

    // ── Init ──────────────────────────────────────────────────────────────────
    selectCategory('pending');
    refreshAllCounts();
    startReceiverAutoRefresh();

})();
</script>
}
