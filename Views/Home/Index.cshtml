@{
    ViewData["Title"] = "Create Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="auth-page" id="signupPage" aria-label="Create Account">
    <div class="auth-ambient-glow" aria-hidden="true"></div>

    <div class="auth-shell">
        <!-- Sidebar -->
        <aside class="auth-sidebar">
            <div>
                <p class="eyebrow">Join the Network</p>
                <h1>Feed a community.<br/>Start today.</h1>
                <p class="desc">
                    FoodBridge connects surplus food with people who need it most.
                    Register as a Donor to list food, or as a Receiver to request donations.
                </p>

                <div class="feature-bullets">
                    <div class="bullet-item">
                        <span class="bullet-icon" aria-hidden="true">&#10003;</span>
                        <span>Register in under 60 seconds</span>
                    </div>
                    <div class="bullet-item">
                        <span class="bullet-icon" aria-hidden="true">&#10003;</span>
                        <span>Choose your role — Donor or Receiver</span>
                    </div>
                    <div class="bullet-item">
                        <span class="bullet-icon" aria-hidden="true">&#10003;</span>
                        <span>Instant access to the food network</span>
                    </div>
                    <div class="bullet-item">
                        <span class="bullet-icon" aria-hidden="true">&#10003;</span>
                        <span>Secure JWT-based authentication</span>
                    </div>
                </div>
            </div>
            <p class="quote-footer">
                &ldquo;Every meal shared is a community strengthened.&rdquo;
            </p>
        </aside>

        <!-- Form Panel -->
        <div class="auth-form-panel">
            <div class="form-header">
                <span class="tag-pill">New Account</span>
                <h2>Create your account</h2>
                <p>Fill in your details to join the FoodBridge network.</p>
            </div>

            <form id="signupForm" novalidate>

                <!-- Username -->
                <div class="form-group">
                    <label for="signupUsername">Full Name</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#9786;</span>
                        <input id="signupUsername"
                               name="Username"
                               type="text"
                               placeholder="e.g. Aditya Sharma"
                               autocomplete="name"
                               required />
                    </div>
                </div>

                <!-- Email -->
                <div class="form-group">
                    <label for="signupEmail">Email Address</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#9993;</span>
                        <input id="signupEmail"
                               name="EmailID"
                               type="email"
                               placeholder="you@example.com"
                               autocomplete="email"
                               required />
                    </div>
                </div>

                <!-- Password -->
                <div class="form-group">
                    <label for="signupPassword">Password</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#128274;</span>
                        <input id="signupPassword"
                               name="password"
                               type="password"
                               placeholder="Choose a strong password"
                               autocomplete="new-password"
                               required />
                        <button type="button" class="input-toggle-btn" id="toggleSignupPwd" aria-label="Toggle password visibility">SHOW</button>
                    </div>
                </div>

                <!-- Role -->
                <div class="form-group">
                    <label for="signupRole">I am a</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#9670;</span>
                        <select id="signupRole" name="role" required>
                            <option value="" disabled selected>Select your role…</option>
                            <option value="Donor">Donor — I have food to share</option>
                            <option value="Receiver">Receiver — I need food donations</option>
                            <option value="Transporter">Transporter — Food Delivery Partner</option>
                        </select>
                    </div>
                </div>

                <!-- City -->
                <div class="form-group">
                    <label for="signupCity">City</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#128205;</span>
                        <input id="signupCity"
                               name="city"
                               type="text"
                               placeholder="e.g. Mumbai"
                               autocomplete="address-level2"
                               required />
                    </div>
                </div>

                <!-- Feedback -->
                <div id="signupMessage" class="form-message" role="alert" aria-live="polite"></div>

                <!-- Submit -->
                <button id="signupSubmitBtn" class="auth-submit-btn" type="submit">
                    <span>Create Account</span>
                    <span aria-hidden="true">&rarr;</span>
                </button>
            </form>

            <p class="auth-switch-note">
                Already have an account?
                <a href="/Home/Login">Sign in here</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
<script>
(function () {
    'use strict';

    // If already logged in, redirect away from signup
    if (window.FoodBridge && window.FoodBridge.getToken()) {
        var role = window.FoodBridge.getUserRole();
        if (role === 'Donor') { window.location.replace('/Home/DonerHome'); return; }
        if (role === 'Receiver') { window.location.replace('/Home/ReceiverHome'); return; }
    }

    // Password toggle
    var toggleBtn = document.getElementById('toggleSignupPwd');
    var pwdInput  = document.getElementById('signupPassword');
    if (toggleBtn && pwdInput) {
        toggleBtn.addEventListener('click', function () {
            var isHidden = pwdInput.type === 'password';
            pwdInput.type = isHidden ? 'text' : 'password';
            toggleBtn.textContent = isHidden ? 'HIDE' : 'SHOW';
        });
    }

    // Form submission
    var form      = document.getElementById('signupForm');
    var submitBtn = document.getElementById('signupSubmitBtn');
    var msgEl     = document.getElementById('signupMessage');

    function showMsg(text, isError) {
        msgEl.textContent = text;
        msgEl.className   = 'form-message ' + (isError ? 'is-error' : 'is-success');
    }

    function setLoading(loading) {
        submitBtn.disabled = loading;
        submitBtn.innerHTML = loading
            ? 'Creating account… <span class="spinner-dot" aria-hidden="true"></span>'
            : '<span>Create Account</span><span aria-hidden="true">&rarr;</span>';
    }

    form.addEventListener('submit', async function (e) {
        e.preventDefault();
        msgEl.textContent = '';
        msgEl.className   = 'form-message';

        var username = document.getElementById('signupUsername').value.trim();
        var email    = document.getElementById('signupEmail').value.trim();
        var password = document.getElementById('signupPassword').value;
        var role     = document.getElementById('signupRole').value;
        var city     = document.getElementById('signupCity').value.trim();

        // Client-side validation
        if (!username) { showMsg('Please enter your full name.', true); return; }
        if (!email)    { showMsg('Please enter a valid email address.', true); return; }
        if (!password || password.length < 6) { showMsg('Password must be at least 6 characters.', true); return; }
        if (!role)     { showMsg('Please select your role.', true); return; }
        if (!city)     { showMsg('Please enter your city.', true); return; }

        setLoading(true);

        try {
            var response = await fetch('/signup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    Username: username,
                    EmailID:  email,
                    password: password,
                    role:     role,
                    city:     city
                })
            });

            var text = await response.text();

            if (text === 'success') {
                showMsg('Account created! Redirecting to login…', false);
                setTimeout(function () {
                    window.location.href = '/Home/Login';
                }, 1200);
            } else if (text === 'user already exists') {
                showMsg('An account with this email already exists. Please sign in.', true);
            } else if (!response.ok) {
                showMsg('Server error (' + response.status + '). Please try again.', true);
            } else {
                showMsg(text || 'Unexpected response. Please try again.', true);
            }
        } catch (err) {
            showMsg('Network error. Please check your connection.', true);
        } finally {
            setLoading(false);
        }
    });
})();
</script>
}
