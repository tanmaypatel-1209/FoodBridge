@{
    ViewData["Title"] = "Donor Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container" id="donerHomePage">

    <!-- Hero / Greeting -->
    <div class="donor-hero" id="donorHeroSection">
        <div class="donor-hero-text">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="tag-pill">Donor Dashboard</span>
                <a href="/Home/Profile" class="btn-secondary-custom" style="padding:3px 10px; font-size:11px; text-decoration:none;">
                    &#9998; Edit Profile
                </a>
            </div>
            <h1 id="donorGreeting">Welcome back, Donor.</h1>
            <p>Track your food donations across categories and contribute surplus meals.</p>
        </div>
        <div class="donor-metrics">
            <div class="metric-card metric-card-interactive" id="mCardPending" title="View Pending Donations">
                <span class="metric-value highlight" id="metricPending">—</span>
                <span class="metric-label">Pending</span>
            </div>
            <div class="metric-card metric-card-interactive" id="mCardAllocated" title="View Allocated Donations">
                <span class="metric-value" style="color:#2563eb;" id="metricAllocated">—</span>
                <span class="metric-label">Allocated</span>
            </div>
            <div class="metric-card metric-card-interactive" id="mCardNotMatched" title="View Unmatched Donations">
                <span class="metric-value" style="color:#dc2626;" id="metricNotMatched">—</span>
                <span class="metric-label">Not Matched</span>
            </div>
            <div class="metric-card metric-card-interactive" id="mCardDone" title="View Completed Donations">
                <span class="metric-value" style="color:#16a34a;" id="metricDone">—</span>
                <span class="metric-label">Completed</span>
            </div>
        </div>
    </div>

    <!-- Tab Navigation with 4 Food Categories + Add Donation -->
    <div class="donor-nav-tabs" role="tablist" aria-label="Donor food categories">
        <button class="tab-btn active" id="tabPending" data-category="pending" role="tab" aria-selected="true" aria-controls="feedPanel">
            <span class="tab-icon" aria-hidden="true">&#9203;</span> Pending
            <span class="tab-count-badge" id="badgePending">0</span>
        </button>
        <button class="tab-btn" id="tabAllocated" data-category="Allocated" role="tab" aria-selected="false" aria-controls="feedPanel">
            <span class="tab-icon" aria-hidden="true">&#129309;</span> Allocated
            <span class="tab-count-badge" id="badgeAllocated">0</span>
        </button>
        <button class="tab-btn" id="tabNotMatched" data-category="NotMatched" role="tab" aria-selected="false" aria-controls="feedPanel">
            <span class="tab-icon" aria-hidden="true">&#9888;</span> Not Matched
            <span class="tab-count-badge" id="badgeNotMatched">0</span>
        </button>
        <button class="tab-btn" id="tabDone" data-category="done" role="tab" aria-selected="false" aria-controls="feedPanel">
            <span class="tab-icon" aria-hidden="true">&#10003;</span> Completed
            <span class="tab-count-badge" id="badgeDone">0</span>
        </button>
        <button class="tab-btn" id="tabAddFood" role="tab" aria-selected="false" aria-controls="addFoodPanel" style="margin-left:auto;">
            <span class="tab-icon" aria-hidden="true">&#43;</span> Add Donation
        </button>
    </div>

    <!-- Workspace: Feed Panel -->
    <div id="feedPanel" role="tabpanel" aria-labelledby="tabPending">
        <div class="donor-feed-section">
            <div class="feed-header">
                <div>
                    <h3 id="categoryHeading">Pending Food Donations</h3>
                    <p id="categorySubtitle">Listings currently awaiting matching or allocation.</p>
                </div>
                <button id="refreshFeedBtn" class="btn-secondary-custom" type="button" aria-label="Refresh donations list">
                    &#8635; Refresh
                </button>
            </div>

            <!-- Loading State -->
            <div id="feedLoading" class="feed-state" aria-live="polite" style="display:none;">
                <div class="feed-loading-inner">
                    <span class="spinner-dot" style="display:inline-block;border-color:rgba(0,0,0,.15);border-top-color:var(--orange-primary);width:22px;height:22px;" aria-hidden="true"></span>
                    <span>Loading donations…</span>
                </div>
            </div>

            <!-- Error State -->
            <div id="feedError" class="feed-state is-error" role="alert" aria-live="assertive" style="display:none;"></div>

            <!-- Food Grid -->
            <div id="foodGrid" class="food-grid" aria-label="Food donation listings">
                <!-- Cards rendered by JS -->
            </div>
        </div>
    </div>

    <!-- Workspace: Add Food Panel -->
    <div id="addFoodPanel" role="tabpanel" aria-labelledby="tabAddFood" style="display:none;">
        <div class="donor-portal-card" style="max-width:640px;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h3 class="card-title mb-0">List a Food Donation</h3>
                <span class="portion-pill">POST /DonerHome</span>
            </div>
            <p class="card-subtitle">
                Fill in the details below. Your email is auto-filled from your session.
            </p>

            <form id="addFoodForm" novalidate>

                <!-- Food Title -->
                <div class="form-group mb-3">
                    <label for="dfFoodName">Food Title / Description <span aria-hidden="true" style="color:var(--orange-primary)">*</span></label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#9776;</span>
                        <input id="dfFoodName" name="FoodName" type="text"
                               placeholder="e.g. Fresh Baked Breads &amp; Pastries" required />
                    </div>
                </div>

                <!-- Email (auto-filled, readonly) -->
                <div class="form-group mb-3">
                    <label for="dfEmailID">Donor Email (from your account)</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#9993;</span>
                        <input id="dfEmailID" name="emailID" type="email"
                               placeholder="your-email@example.com"
                               readonly style="background:var(--bg-surface);cursor:not-allowed;" />
                    </div>
                </div>

                <!-- Quantity -->
                <div class="form-group mb-3">
                    <label for="dfQuantity">Quantity (Estimated Servings) <span aria-hidden="true" style="color:var(--orange-primary)">*</span></label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#9830;</span>
                        <input id="dfQuantity" name="quntity" type="number"
                               min="1" placeholder="e.g. 25" required />
                    </div>
                </div>

                <!-- Items -->
                <div class="form-group mb-3">
                    <label for="dfItems">Included Items <span style="color:var(--text-muted);font-weight:400;">(comma-separated)</span></label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#9679;</span>
                        <input id="dfItems" name="items" type="text"
                               placeholder="e.g. Sourdough, Bagels, Croissants" />
                    </div>
                </div>

                <!-- Donation Date / Time -->
                <div class="form-group mb-3">
                    <label for="dfDonationDate">Donation / Prepared (Date &amp; Time)</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#128197;</span>
                        <input id="dfDonationDate" name="donationDateTime" type="datetime-local" />
                    </div>
                </div>

                <!-- Location row -->
                <div class="form-group-row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                    <div class="form-group mb-3">
                        <label for="dfCity">City</label>
                        <div class="input-container">
                            <span class="input-icon" aria-hidden="true">&#128205;</span>
                            <input id="dfCity" name="city" type="text" placeholder="e.g. Mumbai" />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label for="dfState">State</label>
                        <div class="input-container">
                            <span class="input-icon" aria-hidden="true">&#127757;</span>
                            <input id="dfState" name="state" type="text" placeholder="e.g. Maharashtra" />
                        </div>
                    </div>
                </div>

                <!-- Specific Address -->
                <div class="form-group mb-3">
                    <label for="dfPerfectLocation">Specific Pickup Address</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#9872;</span>
                        <input id="dfPerfectLocation" name="perfectLocation" type="text"
                               placeholder="e.g. Shop 4, MG Road, Near Railway Station" />
                    </div>
                </div>

                <!-- Feedback -->
                <div id="addFoodMessage" class="form-message mb-3" role="alert" aria-live="polite"></div>

                <!-- Submit -->
                <button id="addFoodSubmitBtn" class="auth-submit-btn" type="submit">
                    <span>Submit Donation</span>
                    <span aria-hidden="true">&rarr;</span>
                </button>
            </form>
        </div>
    </div>

</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     EDIT FOOD MODAL
     ══════════════════════════════════════════════════════════════════════════ -->
<div id="editFoodModal" style="display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,0.55);overflow-y:auto;" role="dialog" aria-modal="true" aria-labelledby="editFoodModalTitle">
    <div style="max-width:560px;margin:40px auto;background:var(--bg-card,#1e293b);border-radius:16px;padding:32px;box-shadow:0 8px 48px rgba(0,0,0,0.4);position:relative;">
        <button id="closeEditFoodModalBtn" type="button" aria-label="Close edit form"
            style="position:absolute;top:16px;right:16px;background:none;border:none;color:var(--text-muted,#94a3b8);font-size:22px;cursor:pointer;line-height:1;">&#10005;</button>

        <h3 id="editFoodModalTitle" style="margin:0 0 6px 0;font-size:20px;font-weight:700;">Edit Food Donation</h3>
        <p style="color:var(--text-muted,#94a3b8);font-size:13px;margin:0 0 22px 0;">Update the details below. Quantity cannot be changed if the food is already allocated.</p>

        <form id="editFoodForm" novalidate>
            <input type="hidden" id="editFoodId" />

            <div class="form-group mb-3">
                <label for="editFoodName">Food Title / Description</label>
                <div class="input-container">
                    <span class="input-icon" aria-hidden="true">&#9776;</span>
                    <input id="editFoodName" type="text" placeholder="e.g. Vegetable Pulao" />
                </div>
            </div>

            <div class="form-group mb-3">
                <label for="editFoodQty">Quantity (Servings)</label>
                <div class="input-container">
                    <span class="input-icon" aria-hidden="true">&#9830;</span>
                    <input id="editFoodQty" type="number" min="1" placeholder="e.g. 50" />
                </div>
                <small id="editFoodQtyNote" style="color:var(--text-muted,#94a3b8);font-size:11px;"></small>
            </div>

            <div class="form-group mb-3">
                <label for="editFoodItems">Included Items <span style="color:var(--text-muted);font-weight:400;">(comma-separated)</span></label>
                <div class="input-container">
                    <span class="input-icon" aria-hidden="true">&#9679;</span>
                    <input id="editFoodItems" type="text" placeholder="e.g. Rice, Dal, Sabzi" />
                </div>
            </div>

            <div class="form-group mb-3">
                <label for="editFoodDate">Donation Date &amp; Time</label>
                <div class="input-container">
                    <span class="input-icon" aria-hidden="true">&#128197;</span>
                    <input id="editFoodDate" type="datetime-local" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                <div class="form-group mb-3">
                    <label for="editFoodCity">City</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#128205;</span>
                        <input id="editFoodCity" type="text" placeholder="e.g. Mumbai" />
                    </div>
                </div>
                <div class="form-group mb-3">
                    <label for="editFoodState">State</label>
                    <div class="input-container">
                        <span class="input-icon" aria-hidden="true">&#127757;</span>
                        <input id="editFoodState" type="text" placeholder="e.g. Maharashtra" />
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label for="editFoodLocation">Specific Pickup Address</label>
                <div class="input-container">
                    <span class="input-icon" aria-hidden="true">&#9872;</span>
                    <input id="editFoodLocation" type="text" placeholder="e.g. Shop 4, MG Road" />
                </div>
            </div>

            <div id="editFoodMessage" class="form-message mb-3" role="alert" aria-live="polite"></div>

            <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:8px;">
                <button id="cancelEditFoodBtn" type="button" class="btn-secondary-custom">Cancel</button>
                <button id="saveEditFoodBtn" type="submit" class="auth-submit-btn" style="padding:10px 28px;">
                    <span>Save Changes</span> <span aria-hidden="true">&rarr;</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     DELETE CONFIRMATION MODAL
     ══════════════════════════════════════════════════════════════════════════ -->
<div id="deleteFoodModal" style="display:none;position:fixed;inset:0;z-index:10001;background:rgba(0,0,0,0.6);display:none;align-items:center;justify-content:center;" role="dialog" aria-modal="true" aria-labelledby="deleteFoodModalTitle">
    <div style="max-width:440px;margin:auto;background:var(--bg-card,#1e293b);border-radius:16px;padding:32px;box-shadow:0 8px 48px rgba(0,0,0,0.4);position:relative;top:50%;transform:translateY(-50%);">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
            <span style="font-size:28px;">&#9888;</span>
            <h3 id="deleteFoodModalTitle" style="margin:0;font-size:18px;font-weight:700;">Delete Food Donation?</h3>
        </div>
        <p id="deleteFoodModalDesc" style="color:var(--text-muted,#94a3b8);font-size:14px;margin:0 0 24px 0;">
            Are you sure you want to delete this food donation? This action cannot be undone.
        </p>
        <input type="hidden" id="deleteFoodId" />
        <div id="deleteModalMessage" class="form-message mb-3" role="alert" aria-live="polite"></div>
        <div style="display:flex;gap:12px;justify-content:flex-end;">
            <button id="cancelDeleteFoodBtn" type="button" class="btn-secondary-custom">Cancel</button>
            <button id="confirmDeleteFoodBtn" type="button"
                style="background:linear-gradient(135deg,#dc2626,#b91c1c);color:#fff;border:none;padding:10px 24px;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;">
                &#128465; Delete
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    // ── Auth Guard ───────────────────────────────────────────────────────────
    var token = window.FoodBridge ? window.FoodBridge.getToken() : '';
    if (!token) { window.location.replace('/Home/Login'); return; }
    if (window.FoodBridge && !window.FoodBridge.isDonor()) {
        window.location.replace('/Home/Login'); return;
    }

    // ── Greet donor ──────────────────────────────────────────────────────────
    var email    = window.FoodBridge ? window.FoodBridge.getUserEmail() : '';
    var greeting = document.getElementById('donorGreeting');
    if (greeting && email) {
        var name = email.split('@@')[0];
        greeting.textContent = 'Welcome back, ' + name.charAt(0).toUpperCase() + name.slice(1) + '.';
    }

    // Auto-fill email in the add-food form
    var emailInput = document.getElementById('dfEmailID');
    if (emailInput && email) emailInput.value = email;

    // ── Category Configuration ───────────────────────────────────────────────
    var CATEGORIES = {
        'pending': {
            title: 'Pending Food Donations',
            subtitle: 'Donations waiting to be matched with recipient requirements.',
            url: '/DonerHome/display/pending',
            emptyText: 'No pending food donations.',
            emptyDesc: 'New food donations you submit will appear here until allocated.'
        },
        'Allocated': {
            title: 'Allocated Food Donations',
            subtitle: 'Donations that have been matched and reserved for receiving NGOs.',
            url: '/DonerHome/display/Allocated',
            emptyText: 'No allocated food donations.',
            emptyDesc: 'When your pending donations are matched with recipient requests, they will show up here.'
        },
        'NotMatched': {
            title: 'Unmatched Food Donations',
            subtitle: 'Listings that could not be matched automatically or require review.',
            url: '/DonerHome/display/NotMatched',
            emptyText: 'No unmatched food donations.',
            emptyDesc: 'Items that cannot be fulfilled within constraints will be tracked here.'
        },
        'done': {
            title: 'Completed Food Donations',
            subtitle: 'Donations that have been successfully distributed and fulfilled.',
            url: '/DonerHome/display/done',
            emptyText: 'No completed food donations yet.',
            emptyDesc: 'Donations marked as completed will be recorded here.'
        }
    };

    var currentCategory = 'pending';

    // ── UI Elements ──────────────────────────────────────────────────────────
    var categoryTabs = {
        'pending': document.getElementById('tabPending'),
        'Allocated': document.getElementById('tabAllocated'),
        'NotMatched': document.getElementById('tabNotMatched'),
        'done': document.getElementById('tabDone')
    };

    var tabAddFood        = document.getElementById('tabAddFood');
    var feedPanel         = document.getElementById('feedPanel');
    var addPanel          = document.getElementById('addFoodPanel');
    var categoryHeading   = document.getElementById('categoryHeading');
    var categorySubtitle  = document.getElementById('categorySubtitle');
    var feedLoading       = document.getElementById('feedLoading');
    var feedError         = document.getElementById('feedError');
    var foodGrid          = document.getElementById('foodGrid');

    var badges = {
        'pending': document.getElementById('badgePending'),
        'Allocated': document.getElementById('badgeAllocated'),
        'NotMatched': document.getElementById('badgeNotMatched'),
        'done': document.getElementById('badgeDone')
    };

    var metricEls = {
        'pending': document.getElementById('metricPending'),
        'Allocated': document.getElementById('metricAllocated'),
        'NotMatched': document.getElementById('metricNotMatched'),
        'done': document.getElementById('metricDone')
    };

    // Metric card click-to-filter
    document.getElementById('mCardPending').addEventListener('click', function() { selectCategory('pending'); });
    document.getElementById('mCardAllocated').addEventListener('click', function() { selectCategory('Allocated'); });
    document.getElementById('mCardNotMatched').addEventListener('click', function() { selectCategory('NotMatched'); });
    document.getElementById('mCardDone').addEventListener('click', function() { selectCategory('done'); });

    // Tab buttons event listeners
    Object.keys(categoryTabs).forEach(function(cat) {
        if (categoryTabs[cat]) {
            categoryTabs[cat].addEventListener('click', function() {
                selectCategory(cat);
            });
        }
    });

    tabAddFood.addEventListener('click', function() {
        showAddPanel();
    });

    function showAddPanel() {
        feedPanel.style.display = 'none';
        addPanel.style.display  = '';
        Object.keys(categoryTabs).forEach(function(k) {
            categoryTabs[k].classList.remove('active');
            categoryTabs[k].setAttribute('aria-selected', 'false');
        });
        tabAddFood.classList.add('active');
        tabAddFood.setAttribute('aria-selected', 'true');
    }

    function selectCategory(cat) {
        if (!CATEGORIES[cat]) return;
        currentCategory = cat;

        feedPanel.style.display = '';
        addPanel.style.display  = 'none';

        Object.keys(categoryTabs).forEach(function(k) {
            var isActive = (k === cat);
            categoryTabs[k].classList.toggle('active', isActive);
            categoryTabs[k].setAttribute('aria-selected', String(isActive));
        });
        tabAddFood.classList.remove('active');
        tabAddFood.setAttribute('aria-selected', 'false');

        categoryHeading.textContent  = CATEGORIES[cat].title;
        categorySubtitle.textContent = CATEGORIES[cat].subtitle;

        loadCategoryFeed(cat);
    }

    // ── Status Badges & Card Template ────────────────────────────────────────
    function statusBadgeHtml(status) {
        var s = (status || 'pending').toLowerCase();
        var color = '#f97316';
        var bg = 'rgba(249, 115, 22, 0.12)';
        var label = 'Pending';

        if (s === 'pending') {
            color = '#f97316'; bg = 'rgba(249, 115, 22, 0.12)'; label = 'Pending';
        } else if (s === 'allocated') {
            color = '#2563eb'; bg = 'rgba(37, 99, 235, 0.12)'; label = 'Allocated';
        } else if (s === 'notmatched' || s === 'not matched') {
            color = '#dc2626'; bg = 'rgba(220, 38, 38, 0.12)'; label = 'Not Matched';
        } else if (s === 'done' || s === 'completed') {
            color = '#16a34a'; bg = 'rgba(22, 163, 74, 0.12)'; label = 'Completed';
        } else if (s === 'cancelled') {
            color = '#6b7280'; bg = 'rgba(107, 114, 128, 0.12)'; label = 'Cancelled';
        }

        return '<span class="status-indicator" style="color:' + color + ';background:' + bg + ';padding:4px 10px;border-radius:999px;font-weight:600;font-size:12px;display:inline-flex;align-items:center;gap:6px;">' +
               '<span class="status-dot" style="background:' + color + ';width:6px;height:6px;border-radius:50%;display:inline-block;"></span>' +
               label + '</span>';
    }

    function formatDate(dt) {
        if (!dt) return '';
        try {
            return new Date(dt).toLocaleString('en-IN', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' });
        } catch(e) { return dt; }
    }

    function escHtml(str) {
        return String(str || '')
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ── FOOD CARD with Edit/Delete buttons (status-based visibility) ──────────
    function buildFoodCard(food) {
        var items = Array.isArray(food.items) ? food.items : [];
        var itemTags = items.length
            ? items.map(function(t) { return '<span class="food-item-tag">' + escHtml(t) + '</span>'; }).join('')
            : '<span class="food-item-tag" style="color:var(--text-muted);">No items listed</span>';

        var loc = [food.perfectLocation, food.city, food.state].filter(Boolean).join(', ');
        var s = (food.status || '').toLowerCase();

        // Determine which action buttons to show based on status
        var canEdit   = (s === 'pending' || s === 'notmatched');
        var canDelete  = (s === 'pending' || s === 'notmatched');
        var canCancel  = (s === 'allocated');
        var isLocked   = (s === 'done' || s === 'cancelled');

        var actionBtns = '';
        if (canEdit) {
            actionBtns += '<button class="btn-edit-food btn-card-action" data-food-id="' + food.id + '" data-food-status="' + escHtml(food.status) + '" title="Edit this donation" style="background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;border:none;padding:6px 14px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:5px;">&#9998; Edit</button>';
        }
        if (canDelete) {
            actionBtns += '<button class="btn-delete-food btn-card-action" data-food-id="' + food.id + '" data-food-name="' + escHtml(food.foodName || food.FoodName || 'this donation') + '" title="Delete this donation" style="background:linear-gradient(135deg,#dc2626,#b91c1c);color:#fff;border:none;padding:6px 14px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:5px;">&#128465; Delete</button>';
        }
        if (canCancel) {
            actionBtns += '<button class="btn-delete-food btn-card-action" data-food-id="' + food.id + '" data-food-name="' + escHtml(food.foodName || food.FoodName || 'this donation') + '" title="Cancel this donation" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;border:none;padding:6px 14px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:5px;">&#9747; Cancel</button>';
        }
        if (isLocked) {
            actionBtns += '<span style="font-size:11px;color:var(--text-muted,#94a3b8);font-style:italic;">&#128274; View only</span>';
        }

        return '<article class="food-card">' +
            '<div class="food-card-top">' +
                '<h4 class="food-title">' + escHtml(food.foodName || food.FoodName || '—') + '</h4>' +
                '<span class="portion-pill">&#9830; ' + (food.quntity || 0) + ' servings</span>' +
            '</div>' +
            '<div class="donor-meta-row">' +
                '<span aria-hidden="true">&#9993;</span>' +
                '<span class="meta-donor">' + escHtml(food.emailID || '') + '</span>' +
                (loc ? '&nbsp;&bull;&nbsp;<span>&#128205; ' + escHtml(loc) + '</span>' : '') +
            '</div>' +
            '<div class="item-tags-wrap">' + itemTags + '</div>' +
            '<div class="food-card-footer">' +
                statusBadgeHtml(food.status) +
                '<span style="color:var(--text-muted);font-size:12px;">' + formatDate(food.donationDateTime) + '</span>' +
            '</div>' +
            (actionBtns ? '<div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">' + actionBtns + '</div>' : '') +
        '</article>';
    }

    // ── Simple Graphical Connection Card for Allocated Matches ───────────────
    function buildMatchedConnectionCard(matched) {
        var food = matched.food || {};
        var need = matched.neededFood || {};
        var del  = matched.delivery || null;

        var donorCity = escHtml(food.city || 'Your City');
        var rcvCity   = escHtml(need.city || food.city || 'Recipient City');
        var donorLoc  = escHtml([food.perfectLocation, food.city, food.state].filter(Boolean).join(', ') || food.location || '—');
        var rcvLoc    = escHtml([need.perfectLocation, need.city, need.state].filter(Boolean).join(', ') || need.location || '—');

        // ── Build delivery status section ──────────────────────────────────
        var delHtml = '';
        if (del) {
            var stepper = buildDonorStepperHtml(del.status);
            var handoverAction = '';

            if (del.status === 'Accepted' || del.status === 'TransporterAssigned') {
                handoverAction = '<div style="margin:12px 0;padding:10px 14px;background:#f0f9ff;border:1px solid #bae6fd;border-radius:8px;font-size:13px;color:#0369a1;font-weight:600;">' +
                    '&#128666; A transporter has accepted this delivery and is on their way to pick up the food.' + '</div>';
            } else if (del.status === 'PickupPending') {
                handoverAction = '<div class="action-callout-banner banner-handover">' +
                    '<div class="banner-content">' +
                        '<span class="banner-title">&#128666; Transporter Has Arrived for Pickup!</span>' +
                        '<span class="banner-desc"><strong>' + escHtml(del.transporterName || del.transporterId || 'Transporter') + '</strong> has arrived at your location. Please verify the food and confirm handover below.</span>' +
                    '</div>' +
                    '<button class="btn-delivery-action btn-confirm-handover" data-del-id="' + del.deliveryId + '">' +
                        '&#10003; Confirm Food Handover' +
                    '</button>' +
                '</div>';
            } else if (del.status === 'PickedUp' || del.status === 'InTransit') {
                handoverAction = '<div style="margin:12px 0;padding:10px 14px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;font-size:13px;color:#1e40af;font-weight:600;">' +
                    '&#128666; Handover Complete &mdash; Transporter <strong>' + escHtml(del.transporterName || del.transporterId || '') + '</strong> is currently in transit to the recipient shelter.' + '</div>';
            } else if (del.status === 'ReceiverArrived') {
                handoverAction = '<div style="margin:12px 0;padding:10px 14px;background:#faf5ff;border:1px solid #e9d5ff;border-radius:8px;font-size:13px;color:#6b21a8;font-weight:600;">' +
                    '&#127970; Transporter arrived at Receiver destination &mdash; Awaiting final recipient confirmation.' + '</div>';
            } else if (del.status === 'Delivered') {
                handoverAction = '<div style="margin:12px 0;padding:10px 14px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;font-size:13px;color:#166534;font-weight:700;">' +
                    '&#10003; Food donation successfully delivered and confirmed by recipient!' + '</div>';
            } else {
                handoverAction = '<div style="margin:12px 0;padding:10px 14px;background:#fafafa;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;color:#64748b;font-weight:500;">' +
                    '&#9203; Waiting for a transporter to accept this delivery job.' + '</div>';
            }

            delHtml = '<div style="margin-top:14px;padding-top:14px;border-top:1px dashed var(--border-subtle,#e2e8f0);">' +
                '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">' +
                    '<span style="font-size:12px;font-weight:700;text-transform:uppercase;color:#475569;">Delivery Status: <strong style="color:var(--text-primary,#1e293b);">' + escHtml(del.status) + '</strong></span>' +
                    '<span style="font-size:12px;color:#64748b;">Transporter: <strong>' + escHtml(del.transporterName || del.transporterId || 'Awaiting Partner') + '</strong></span>' +
                '</div>' + stepper + handoverAction + '</div>';
        }

        // Cancel button for allocated cards (if delivery not yet picked up)
        var cancelBtn = '';
        var canCancelAllocated = !del ||
            (del.status === 'AwaitingTransporter' || del.status === 'Accepted' || del.status === 'PickupPending');
        var isPickedUpOrBeyond = del &&
            (del.status === 'PickedUp' || del.status === 'InTransit' || del.status === 'ReceiverArrived' || del.status === 'Delivered');
        if (food.id && !isPickedUpOrBeyond) {
            cancelBtn = '<div style="margin-top:12px;">' +
                '<button class="btn-delete-food btn-card-action" data-food-id="' + food.id + '" data-food-name="' + escHtml(food.foodName || food.FoodName || 'this donation') + '"' +
                ' style="background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;border:none;padding:6px 14px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:5px;">&#9747; Cancel Donation</button>' +
                '</div>';
        }

        return '<article class="match-simple-card">' +
            '<div class="match-simple-header">' +
                '<div class="match-simple-title">' +
                    '<strong>Allocated Match</strong>' +
                    '<span class="match-route-tag">' + donorCity + ' &rarr; ' + rcvCity + '</span>' +
                '</div>' +
                '<span class="match-badge-simple">Allocated</span>' +
            '</div>' +
            '<div class="match-simple-body">' +
                '<div class="match-col">' +
                    '<div class="match-col-role role-donor">&#127869; YOUR DONATION</div>' +
                    '<h4 class="col-food-title">' + escHtml(food.foodName || food.FoodName || 'Donated Food') + '</h4>' +
                    '<div><span class="col-qty-pill qty-donor">&#9830; ' + (food.quntity || 0) + ' Servings</span></div>' +
                    '<div class="col-info-list">' +
                        '<div class="col-info-item"><span class="icon">&#9993;</span> ' + escHtml(food.emailID || 'You') + '</div>' +
                        '<div class="col-info-item"><span class="icon">&#128205;</span> ' + donorLoc + '</div>' +
                        (food.donationDateTime ? '<div class="col-info-item"><span class="icon">&#128197;</span> ' + formatDate(food.donationDateTime) + '</div>' : '') +
                    '</div>' +
                '</div>' +
                '<div class="match-connector">' +
                    '<div class="connector-line"></div>' +
                    '<div class="connector-icon-circle">&#8646;</div>' +
                    '<div class="connector-label">MATCHED</div>' +
                '</div>' +
                '<div class="match-col">' +
                    '<div class="match-col-role role-receiver">&#127970; RECIPIENT NGO</div>' +
                    '<h4 class="col-food-title">' + escHtml(need.foodName || 'Requirement') + '</h4>' +
                    '<div><span class="col-qty-pill qty-receiver">&#9830; ' + (need.quntity || 0) + ' Servings Needed</span></div>' +
                    '<div class="col-info-list">' +
                        '<div class="col-info-item"><span class="icon">&#9993;</span> ' + escHtml(need.emailID || 'Recipient NGO') + '</div>' +
                        '<div class="col-info-item"><span class="icon">&#128205;</span> ' + rcvLoc + '</div>' +
                        (need.requestDateTime ? '<div class="col-info-item"><span class="icon">&#128197;</span> ' + formatDate(need.requestDateTime) + '</div>' : '') +
                    '</div>' +
                '</div>' +
            '</div>' +
            delHtml +
            cancelBtn +
            '<div class="match-simple-footer">' +
                '<div>Pickup: <strong>' + donorLoc + '</strong> &rarr; Delivery: <strong>' + rcvLoc + '</strong></div>' +
                (need.emailID ? '<a href="mailto:' + escHtml(need.emailID) + '?subject=FoodBridge%20Donation%20Handover">&#9993; Coordinate with Recipient NGO</a>' : '') +
            '</div>' +
        '</article>';
    }

        function buildDonorStepperHtml(status) {
            var steps = [
                { key: 'Matched', label: 'Matched' },
                { key: 'Accepted', label: 'Transporter' },
                { key: 'PickupPending', label: 'At Pickup' },
                { key: 'PickedUp', label: 'Handover' },
                { key: 'InTransit', label: 'In Transit' },
                { key: 'Delivered', label: 'Delivered' }
            ];

            var stepOrder = ['AwaitingTransporter', 'Accepted', 'PickupPending', 'PickedUp', 'InTransit', 'ReceiverArrived', 'Delivered'];
            var currentIdx = stepOrder.indexOf(status);
            if (currentIdx === -1 && (status === 'TransporterAssigned')) currentIdx = 1;

            var html = '<div class="delivery-stepper" style="margin: 14px 0 8px 0;">';
            var pct = Math.max(0, Math.min(100, (currentIdx / (stepOrder.length - 1)) * 100));
            html += `<div class="stepper-progress-line" style="width:${pct}%;"></div>`;

            steps.forEach(function (s, idx) {
                var stepIndex = stepOrder.indexOf(s.key);
                if (s.key === 'Matched') stepIndex = 0;
                var isDone = currentIdx >= stepIndex;
                var isCurr = currentIdx === stepIndex;
                var cls = isDone ? 'is-done' : (isCurr ? 'is-current' : '');

                html += `
                    <div class="stepper-step ${cls}">
                        <div class="stepper-dot">${isDone ? '&#10003;' : (idx + 1)}</div>
                        <span class="stepper-step-title">${s.label}</span>
                    </div>
                `;
            });
            html += '</div>';
            return html;
        }

        // ── Feed Loader ──────────────────────────────────────────────────────────
        async function loadCategoryFeed(cat) {
            feedLoading.style.display = '';
            feedError.style.display   = 'none';
            foodGrid.innerHTML        = '';

            var config = CATEGORIES[cat];
            if (!config) return;

            try {
                var [resp, delResp] = await Promise.all([
                    window.FoodBridge.authFetch(config.url),
                    window.FoodBridge.authFetch('/Donor/deliveries')
                ]);

                if (resp.status === 401 || resp.status === 403 || delResp.status === 401) {
                    window.location.replace('/Home/Login');
                    return;
                }
                if (!resp.ok) {
                    throw new Error('Server returned ' + resp.status);
                }

                var data = await resp.json();
                var deliveries = delResp.ok ? await delResp.json() : [];
                feedLoading.style.display = 'none';

                var count = Array.isArray(data) ? data.length : 0;
                if (badges[cat]) badges[cat].textContent = count;
                if (metricEls[cat]) metricEls[cat].textContent = count;

                if (!Array.isArray(data) || data.length === 0) {
                    foodGrid.classList.remove('allocation-feed-layout');
                    foodGrid.innerHTML =
                        '<div class="empty-state">' +
                        '<span class="empty-icon" aria-hidden="true">&#127860;</span>' +
                        '<h4>' + escHtml(config.emptyText) + '</h4>' +
                        '<p>' + escHtml(config.emptyDesc) + '</p>' +
                        '</div>';
                    return;
                }

                if (cat === 'Allocated') {
                    foodGrid.classList.add('allocation-feed-layout');
                    foodGrid.innerHTML = data.map(function(item) {
                        if (item.food && item.neededFood) {
                            // ── STRICT match by foodId only (never by donorId).
                            // A donor can have multiple concurrent allocations — matching
                            // by donorId alone would link the wrong delivery to the wrong card.
                            var del = deliveries.find(function (d) {
                                return item.food && d.foodId === item.food.id;
                            }) || null;
                            item.delivery = del;
                            return buildMatchedConnectionCard(item);
                        }
                        return buildFoodCard(item);
                    }).join('');

                    // Bind handover buttons
                    foodGrid.querySelectorAll('.btn-confirm-handover').forEach(function(btn) {
                        btn.addEventListener('click', async function() {
                            var delId = btn.getAttribute('data-del-id');
                            if (!delId) return;
                            var notes = prompt('Add optional handover notes (or press OK to confirm):') || '';
                            btn.disabled = true;
                            btn.innerHTML = 'Confirming handover… <span class="spinner-dot" aria-hidden="true"></span>';
                            try {
                                var cResp = await window.FoodBridge.authFetch('/Donor/deliveries/' + delId + '/confirm-handover', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ Notes: notes })
                                });
                                var resJson = await cResp.json().catch(function() { return {}; });
                                if (!cResp.ok) {
                                    alert(resJson.message || 'Failed to confirm handover.');
                                    btn.disabled = false;
                                    btn.innerHTML = '&#10003; Confirm Food Handover';
                                    return;
                                }
                                showToast('&#10003; Food handover confirmed! Transporter is now in transit.', 'success');
                                loadCategoryFeed(currentCategory);
                                refreshAllCounts();
                            } catch (cErr) {
                                alert('Network error: ' + cErr.message);
                                btn.disabled = false;
                                btn.innerHTML = '&#10003; Confirm Food Handover';
                            }
                        });
                    });

                } else {
                    foodGrid.classList.remove('allocation-feed-layout');
                    foodGrid.innerHTML = data.map(buildFoodCard).join('');
                }

                // ── Bind Edit buttons ──────────────────────────────────────────
                foodGrid.querySelectorAll('.btn-edit-food').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        var foodId = btn.getAttribute('data-food-id');
                        openEditModal(foodId);
                    });
                });

                // ── Bind Delete/Cancel buttons ─────────────────────────────────
                foodGrid.querySelectorAll('.btn-delete-food').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        var foodId   = btn.getAttribute('data-food-id');
                        var foodName = btn.getAttribute('data-food-name');
                        openDeleteModal(foodId, foodName);
                    });
                });

            } catch (err) {
                feedLoading.style.display = 'none';
                feedError.style.display   = '';
                feedError.textContent     = 'Failed to load ' + cat + ' donations: ' + (err.message || 'Unknown error.');
            }
        }

    // ── Refresh all category counts ───────────────────────────────────────────
    async function refreshAllCounts() {
        var promises = Object.keys(CATEGORIES).map(async function(cat) {
            try {
                var resp = await window.FoodBridge.authFetch(CATEGORIES[cat].url);
                if (resp.ok) {
                    var data = await resp.json();
                    var count = Array.isArray(data) ? data.length : 0;
                    if (badges[cat]) badges[cat].textContent = count;
                    if (metricEls[cat]) metricEls[cat].textContent = count;
                }
            } catch(e) { }
        });
        return Promise.all(promises);
    }

    // ── Toast Notification ────────────────────────────────────────────────────
    function showToast(message, type) {
        var toastId = 'donorToastContainer';
        var container = document.getElementById(toastId);
        if (!container) {
            container = document.createElement('div');
            container.id = toastId;
            container.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:10px;';
            document.body.appendChild(container);
        }
        var toast = document.createElement('div');
        var bgColor = type === 'success' ? '#166534' : type === 'error' ? '#991b1b' : type === 'warning' ? '#92400e' : '#1e40af';
        var icon    = type === 'success' ? '&#10003;' : type === 'error' ? '&#9888;' : type === 'warning' ? '&#9888;' : '&#128666;';
        toast.style.cssText = 'background:' + bgColor + ';color:#fff;padding:12px 18px;border-radius:10px;font-size:14px;font-weight:600;box-shadow:0 4px 24px rgba(0,0,0,0.18);display:flex;align-items:center;gap:10px;min-width:280px;max-width:400px;animation:slideInRight 0.3s ease;';
        toast.innerHTML = '<span style="font-size:18px;">' + icon + '</span><span>' + message + '</span>';
        container.appendChild(toast);
        setTimeout(function() {
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.4s';
            setTimeout(function() { if (toast.parentNode) toast.parentNode.removeChild(toast); }, 400);
        }, 5000);
    }

    // ══════════════════════════════════════════════════════════════════════════
    // EDIT MODAL LOGIC
    // ══════════════════════════════════════════════════════════════════════════
    var editModal    = document.getElementById('editFoodModal');
    var editForm     = document.getElementById('editFoodForm');
    var editMsg      = document.getElementById('editFoodMessage');
    var editSaveBtn  = document.getElementById('saveEditFoodBtn');
    var _editCurrentFood = null; // holds current food data for context

    function openEditModal(foodId) {
        editMsg.textContent = '';
        editMsg.className   = 'form-message mb-3';
        // Fetch the latest data from server for this food (concurrency safety)
        window.FoodBridge.authFetch('/DonerHome/' + foodId)
            .then(function(r) {
                if (r.status === 403) { showToast('&#9888; This food does not belong to you.', 'error'); return null; }
                if (!r.ok) { showToast('&#9888; Could not load food data.', 'error'); return null; }
                return r.json();
            })
            .then(function(food) {
                if (!food) return;
                _editCurrentFood = food;
                document.getElementById('editFoodId').value     = food.id;
                document.getElementById('editFoodName').value   = food.foodName || food.FoodName || '';
                document.getElementById('editFoodQty').value    = food.quntity || '';
                document.getElementById('editFoodItems').value  = Array.isArray(food.items) ? food.items.join(', ') : '';
                document.getElementById('editFoodCity').value   = food.city || '';
                document.getElementById('editFoodState').value  = food.state || '';
                document.getElementById('editFoodLocation').value = food.perfectLocation || '';

                // Set datetime-local value
                if (food.donationDateTime) {
                    try {
                        var d = new Date(food.donationDateTime);
                        var pad = function(n) { return String(n).padStart(2, '0'); };
                        document.getElementById('editFoodDate').value =
                            d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()) +
                            'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
                    } catch(e) { document.getElementById('editFoodDate').value = ''; }
                } else {
                    document.getElementById('editFoodDate').value = '';
                }

                var s = (food.status || '').toLowerCase();
                var isAllocated = s === 'allocated';
                var qtyInput = document.getElementById('editFoodQty');
                var qtyNote  = document.getElementById('editFoodQtyNote');
                if (isAllocated) {
                    qtyInput.disabled = true;
                    qtyInput.style.opacity = '0.5';
                    qtyNote.textContent = 'Quantity is locked — this food is already allocated to a receiver.';
                } else {
                    qtyInput.disabled = false;
                    qtyInput.style.opacity = '';
                    qtyNote.textContent = '';
                }

                editModal.style.display = 'block';
                document.getElementById('editFoodName').focus();
            })
            .catch(function() { showToast('&#9888; Network error loading food data.', 'error'); });
    }

    function closeEditModal() {
        editModal.style.display = 'none';
        _editCurrentFood = null;
        document.getElementById('editFoodQty').disabled = false;
        document.getElementById('editFoodQty').style.opacity = '';
    }

    document.getElementById('closeEditFoodModalBtn').addEventListener('click', closeEditModal);
    document.getElementById('cancelEditFoodBtn').addEventListener('click', closeEditModal);
    editModal.addEventListener('click', function(e) {
        if (e.target === editModal) closeEditModal();
    });

    editForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        editMsg.textContent = '';
        editMsg.className   = 'form-message mb-3';

        var foodId   = document.getElementById('editFoodId').value;
        var foodName = document.getElementById('editFoodName').value.trim();
        var qtyRaw   = document.getElementById('editFoodQty').value;
        var itemsRaw = document.getElementById('editFoodItems').value.trim();
        var city     = document.getElementById('editFoodCity').value.trim();
        var state    = document.getElementById('editFoodState').value.trim();
        var perfLoc  = document.getElementById('editFoodLocation').value.trim();
        var dateVal  = document.getElementById('editFoodDate').value;

        var qtyDisabled = document.getElementById('editFoodQty').disabled;
        var qty = qtyDisabled ? null : (qtyRaw ? parseInt(qtyRaw, 10) : null);

        if (!qtyDisabled && (qty !== null && (isNaN(qty) || qty < 1))) {
            editMsg.textContent = 'Quantity must be a positive number greater than 0.';
            editMsg.className   = 'form-message mb-3 is-error';
            return;
        }

        var items = itemsRaw ? itemsRaw.split(',').map(function(s) { return s.trim(); }).filter(Boolean) : null;

        var payload = {};
        if (foodName) payload.FoodName = foodName;
        if (qty !== null) payload.quntity = qty;
        if (items) payload.items = items;
        if (city) payload.city = city;
        if (state) payload.state = state;
        if (perfLoc) payload.perfectLocation = perfLoc;
        if (dateVal) payload.donationDateTime = window.FoodBridge.toLocalDateTimeString(dateVal);

        editSaveBtn.disabled = true;
        editSaveBtn.innerHTML = 'Saving… <span class="spinner-dot" aria-hidden="true"></span>';

        try {
            var resp = await window.FoodBridge.authFetch('/DonerHome/' + foodId, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            var resJson = await resp.json().catch(function() { return {}; });

            if (resp.status === 403) {
                editMsg.textContent = 'Forbidden: You can only edit your own food donations.';
                editMsg.className   = 'form-message mb-3 is-error';
                return;
            }
            if (!resp.ok) {
                editMsg.textContent = resJson.message || 'Failed to update food donation.';
                editMsg.className   = 'form-message mb-3 is-error';
                return;
            }

            showToast('&#10003; Food donation updated successfully!', 'success');
            closeEditModal();
            loadCategoryFeed(currentCategory);
            refreshAllCounts();

        } catch(err) {
            editMsg.textContent = 'Network error: ' + (err.message || 'Please check your connection.');
            editMsg.className   = 'form-message mb-3 is-error';
        } finally {
            editSaveBtn.disabled = false;
            editSaveBtn.innerHTML = '<span>Save Changes</span> <span aria-hidden="true">&rarr;</span>';
        }
    });

    // ══════════════════════════════════════════════════════════════════════════
    // DELETE / CANCEL MODAL LOGIC
    // ══════════════════════════════════════════════════════════════════════════
    var deleteModal    = document.getElementById('deleteFoodModal');
    var deleteMsgEl    = document.getElementById('deleteModalMessage');
    var confirmDelBtn  = document.getElementById('confirmDeleteFoodBtn');
    var cancelDelBtn   = document.getElementById('cancelDeleteFoodBtn');

    function openDeleteModal(foodId, foodName) {
        document.getElementById('deleteFoodId').value = foodId;
        document.getElementById('deleteFoodModalDesc').textContent =
            'Are you sure you want to delete/cancel "' + (foodName || 'this donation') + '"? This action cannot be undone.';
        deleteMsgEl.textContent = '';
        deleteMsgEl.className   = 'form-message mb-3';
        deleteModal.style.display = 'flex';
    }

    function closeDeleteModal() {
        deleteModal.style.display = 'none';
    }

    cancelDelBtn.addEventListener('click', closeDeleteModal);
    deleteModal.addEventListener('click', function(e) {
        if (e.target === deleteModal) closeDeleteModal();
    });

    confirmDelBtn.addEventListener('click', async function() {
        var foodId = document.getElementById('deleteFoodId').value;
        if (!foodId) return;

        deleteMsgEl.textContent = '';
        deleteMsgEl.className   = 'form-message mb-3';
        confirmDelBtn.disabled  = true;
        confirmDelBtn.innerHTML = 'Deleting… <span class="spinner-dot" aria-hidden="true"></span>';

        try {
            var resp = await window.FoodBridge.authFetch('/DonerHome/' + foodId, { method: 'DELETE' });
            var resJson = await resp.json().catch(function() { return {}; });

            if (resp.status === 403) {
                deleteMsgEl.textContent = 'Forbidden: You can only delete your own food donations.';
                deleteMsgEl.className   = 'form-message mb-3 is-error';
                return;
            }
            if (!resp.ok) {
                deleteMsgEl.textContent = resJson.message || 'Failed to delete food donation.';
                deleteMsgEl.className   = 'form-message mb-3 is-error';
                return;
            }

            showToast('&#128465; Food donation deleted/cancelled successfully.', 'success');
            closeDeleteModal();
            loadCategoryFeed(currentCategory);
            refreshAllCounts();

        } catch(err) {
            deleteMsgEl.textContent = 'Network error: ' + (err.message || 'Please check your connection.');
            deleteMsgEl.className   = 'form-message mb-3 is-error';
        } finally {
            confirmDelBtn.disabled  = false;
            confirmDelBtn.innerHTML = '&#128465; Delete';
        }
    });

    // ── Auto-Polling for delivery status changes ──────────────────────────────
    var _lastDeliveryStatuses = {};
    var _donorAutoRefreshTimer = null;

    function startDonorAutoRefresh() {
        if (_donorAutoRefreshTimer) return;
        _donorAutoRefreshTimer = setInterval(async function() {
            try {
                var delResp = await window.FoodBridge.authFetch('/Donor/deliveries');
                if (!delResp.ok) return;
                var deliveries = await delResp.json();
                var changed = false;
                deliveries.forEach(function(d) {
                    var prevStatus = _lastDeliveryStatuses[d.deliveryId];
                    if (prevStatus !== undefined && prevStatus !== d.status) {
                        changed = true;
                        if (d.status === 'Accepted') {
                            showToast('&#128666; A transporter accepted your delivery for ' + (d.foodName || 'your donation') + '!', 'info');
                        } else if (d.status === 'PickupPending') {
                            showToast('&#9203; Transporter arrived at your pickup location! Please confirm handover.', 'warning');
                        } else if (d.status === 'PickedUp' || d.status === 'InTransit') {
                            showToast('&#10003; Food handover confirmed. Transporter is in transit!', 'success');
                        } else if (d.status === 'Delivered') {
                            showToast('&#127881; Delivery completed! Food has reached the recipient.', 'success');
                        }
                    }
                    _lastDeliveryStatuses[d.deliveryId] = d.status;
                });
                if (changed && currentCategory === 'Allocated') {
                    loadCategoryFeed('Allocated');
                } else if (changed) {
                    refreshAllCounts();
                }
            } catch(e) { }
        }, 10000);
    }

    window.addEventListener('beforeunload', function() {
        if (_donorAutoRefreshTimer) clearInterval(_donorAutoRefreshTimer);
    });

    window.fetchDonorFoodFeed = function() {
        loadCategoryFeed(currentCategory);
        refreshAllCounts();
    };

    document.getElementById('refreshFeedBtn').addEventListener('click', function() {
        loadCategoryFeed(currentCategory);
        refreshAllCounts();
    });

    // ── Add Food Form — POST /DonerHome ──────────────────────────────────────
    var addFoodForm    = document.getElementById('addFoodForm');
    var addFoodSubmit  = document.getElementById('addFoodSubmitBtn');
    var addFoodMessage = document.getElementById('addFoodMessage');

    function showAddMsg(text, isError) {
        addFoodMessage.textContent = text;
        addFoodMessage.className   = 'form-message mb-3 ' + (isError ? 'is-error' : 'is-success');
    }

    function setAddLoading(loading) {
        addFoodSubmit.disabled = loading;
        addFoodSubmit.innerHTML = loading
            ? 'Submitting… <span class="spinner-dot" aria-hidden="true"></span>'
            : '<span>Submit Donation</span><span aria-hidden="true">&rarr;</span>';
    }

    addFoodForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        addFoodMessage.textContent = '';
        addFoodMessage.className   = 'form-message mb-3';

        var foodName        = document.getElementById('dfFoodName').value.trim();
        var emailID         = document.getElementById('dfEmailID').value.trim();
        var quntity         = parseInt(document.getElementById('dfQuantity').value, 10);
        var rawItems        = document.getElementById('dfItems').value.trim();
        var city            = document.getElementById('dfCity').value.trim();
        var state           = document.getElementById('dfState').value.trim();
        var perfectLocation = document.getElementById('dfPerfectLocation').value.trim();
        var donationDateVal = document.getElementById('dfDonationDate').value;
        var parsedDonationDate = window.FoodBridge.toLocalDateTimeString(donationDateVal);

        if (!foodName)          { showAddMsg('Please enter a food title.', true);       return; }
        if (!emailID)           { showAddMsg('Donor email is missing. Please sign in again.', true); return; }
        if (isNaN(quntity) || quntity < 1) { showAddMsg('Please enter a valid quantity (at least 1).', true); return; }

        var items = rawItems
            ? rawItems.split(',').map(function(s) { return s.trim(); }).filter(Boolean)
            : [foodName];

        setAddLoading(true);

        try {
            var resp = await window.FoodBridge.authFetch('/DonerHome', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    FoodName:         foodName,
                    emailID:          emailID,
                    quntity:          quntity,
                    items:            items,
                    donationDateTime: parsedDonationDate,
                    city:             city || null,
                    state:            state || null,
                    perfectLocation:  perfectLocation || null
                })
            });

            if (resp.status === 401 || resp.status === 403) {
                window.location.replace('/Home/Login'); return;
            }

            var text = await resp.text();

            if (text === 'Food added' || (resp.ok && text.toLowerCase().includes('food added'))) {
                showAddMsg('Donation listed successfully! It is now in Pending category.', false);
                addFoodForm.reset();
                if (emailInput) emailInput.value = email;
                refreshAllCounts();
            } else if (text === 'user not found') {
                showAddMsg('Account not found on the server. Please sign in again.', true);
            } else if (!resp.ok) {
                showAddMsg('Server error (' + resp.status + '). Please try again.', true);
            } else {
                showAddMsg(text || 'Unexpected response.', true);
            }

        } catch (err) {
            showAddMsg('Network error: ' + (err.message || 'Please check your connection.'), true);
        } finally {
            setAddLoading(false);
        }
    });

    // ── Initial load ─────────────────────────────────────────────────────────
    selectCategory('pending');
    refreshAllCounts();
    startDonorAutoRefresh();

})();
</script>
}
